// Chart labels project the canonical MTF state.

// v1.22.5: bottom-left SIM recap remains removed; legacy SIM visuals/alerts are also removed.

// Entry alerts use a latched ledger verdict. Choose "Any alert() function call".
var int alertedBornX = na
for slotX = 0 to 6
    if timeframe.in_seconds(array.get(nativePeriods, slotX)) == timeframe.in_seconds()
        GGNativeState pX = f_slot_detail(slotX)
        bool validAlertX = not na(pX) and pX.liveSide != 0 and pX.liveBorn == time and array.get(hostSkips, slotX) == 0 and not (scalpConflict and slotX < 2)
        if enableAlerts and validAlertX and (na(alertedBornX) or pX.liveBorn != alertedBornX)
            alert("GoldGuard " + f_slot_name(slotX) + (pX.liveSide == 1 ? " BUY " : " SELL ") + f_setup_name(pX.liveMethod) + " E=" + f_price(pX.liveEntry) + " SL=" + f_price(pX.liveSL) + " TP=" + f_price(pX.liveTP), alert.freq_once_per_bar)
            alertedBornX := pX.liveBorn

// Audit stream for TradingView chart CSV export. Events are never back-plotted.
// One TF per export: open the actual M5/M15/M30/H1 chart before exporting.
var int auditEntryBorn = na
var int auditExitBorn = na
float auditEB = na
float auditSide = na
float auditE = na
float auditSL = na
float auditTP = na
float auditMethod = na
float auditSkip = na
float auditXB = na
float auditXT = na
float auditXP = na
float auditXCode = na
float auditScore = na
int auditSlot = array.indexof(nativePeriods, timeframe.period)
if auditSlot >= 0 and array.size(lgBorn) > 0 and barstate.isconfirmed
    for auditI = array.size(lgBorn) - 1 to 0
        if array.get(lgSlot, auditI) == auditSlot
            int bornAudit = array.get(lgBorn, auditI)
            if na(auditEntryBorn) or bornAudit > auditEntryBorn
                auditEntryBorn := bornAudit
                auditEB := bornAudit
                auditSide := array.get(lgSide, auditI)
                auditE := array.get(lgE, auditI)
                auditSL := array.get(lgSL, auditI)
                auditTP := array.get(lgTP, auditI)
                auditMethod := array.get(lgMethod, auditI)
                auditSkip := array.get(lgSkip, auditI)
                auditScore := array.get(lgCtx, auditI)
            if array.get(lgRes, auditI) != 0 and (na(auditExitBorn) or bornAudit > auditExitBorn)
                auditExitBorn := bornAudit
                auditXB := bornAudit
                auditXT := array.get(lgEnd, auditI)
                float auditRisk = math.abs(array.get(lgE, auditI) - array.get(lgSL, auditI))
                auditXP := array.get(lgE, auditI) + array.get(lgSide, auditI) * (array.get(lgR, auditI) * auditRisk + costPrice)
                string auditKind = array.get(lgKind, auditI)
                auditXCode := auditKind == "SL" ? -1 : auditKind == "TP" ? 1 : auditKind == "TRAIL/BE" ? 5 : auditKind == "CUT LOSS" ? 6 : auditKind == "STALE" ? 3 : auditKind == "FAILED BREAK" ? 4 : 2
plot(auditEB, "GG_ENTRY_TIME", display = display.data_window)
plot(auditSide, "GG_SIDE", display = display.data_window)
plot(auditE, "GG_ENTRY", display = display.data_window)
plot(auditSL, "GG_INITIAL_SL", display = display.data_window)
plot(auditTP, "GG_TP", display = display.data_window)
plot(auditMethod, "GG_METHOD", display = display.data_window)
plot(auditSkip, "GG_SKIP", display = display.data_window)
plot(auditScore, "GG_SCORE", display = display.data_window)
plot(auditXB, "GG_EXIT_BORN", display = display.data_window)
plot(auditXT, "GG_EXIT_TIME", display = display.data_window)
plot(auditXP, "GG_EXIT_PRICE", display = display.data_window)
plot(auditXCode, "GG_EXIT_CODE", display = display.data_window)


// ===== PERMANENT ON-CHART VALIDATION & TELEMETRY DASHBOARD (v2.0.0) =====
// Statistics are accumulated in permanent variables since startTest and never change when visual history labels are capped or purged.
var table statsTbl = na
if barstate.islast and showStatsTable
    string posStr = statsTablePos == " kiri_bawah" ? position.bottom_left : statsTablePos == " kanan_atas" ? position.top_right : position.bottom_right
    if na(statsTbl)
        statsTbl := table.new(posStr, 6, 10, bgcolor = color.new(color.rgb(18, 24, 38), 8), border_color = color.new(color.rgb(65, 82, 115), 35), border_width = 1)
    float tpRateAll = permStats.totalClosed > 0 ? 100.0 * permStats.tpHits / permStats.totalClosed : 0.0
    float profRateAll = permStats.totalClosed > 0 ? 100.0 * permStats.profExits / permStats.totalClosed : 0.0
    float slRateAll = permStats.totalClosed > 0 ? 100.0 * permStats.slHits / permStats.totalClosed : 0.0
    float cutRateAll = permStats.totalClosed > 0 ? 100.0 * permStats.cutHits / permStats.totalClosed : 0.0
    float expAll = permStats.totalClosed > 0 ? permStats.cumR / permStats.totalClosed : 0.0
    float pfAll = permStats.sumLossR > 0.001 ? permStats.sumWinR / permStats.sumLossR : permStats.sumWinR > 0 ? 99.9 : 0.0
    table.cell(statsTbl, 0, 0, "GOLDGUARD v2.0 TELEMETRY", text_color = color.white, bgcolor = color.rgb(34, 52, 84), text_size = size.tiny)
    table.cell(statsTbl, 1, 0, "N Closed", text_color = color.white, bgcolor = color.rgb(34, 52, 84), text_size = size.tiny)
    table.cell(statsTbl, 2, 0, "TP Hit %", text_color = color.white, bgcolor = color.rgb(34, 52, 84), text_size = size.tiny)
    table.cell(statsTbl, 3, 0, "Prof Exit %", text_color = color.white, bgcolor = color.rgb(34, 52, 84), text_size = size.tiny)
    table.cell(statsTbl, 4, 0, "SL% | Cut%", text_color = color.white, bgcolor = color.rgb(34, 52, 84), text_size = size.tiny)
    table.cell(statsTbl, 5, 0, "Exp(R) | PF | DD", text_color = color.white, bgcolor = color.rgb(34, 52, 84), text_size = size.tiny)

    table.cell(statsTbl, 0, 1, "ALL MTF (Permanen)", text_color = color.yellow, text_size = size.tiny)
    table.cell(statsTbl, 1, 1, str.tostring(permStats.totalClosed), text_color = color.white, text_size = size.tiny)
    table.cell(statsTbl, 2, 1, f_num(tpRateAll) + "%", text_color = tpRateAll >= 70 ? color.lime : color.aqua, text_size = size.tiny)
    table.cell(statsTbl, 3, 1, f_num(profRateAll) + "%", text_color = color.lime, text_size = size.tiny)
    table.cell(statsTbl, 4, 1, f_num(slRateAll) + "% | " + f_num(cutRateAll) + "%", text_color = color.white, text_size = size.tiny)
    table.cell(statsTbl, 5, 1, f_signed_r(expAll) + " | PF " + f_num(pfAll) + " | DD " + f_num(permStats.maxDdR) + "R (Strk " + str.tostring(permStats.maxLossStreak) + ")", text_color = expAll > 0 ? color.lime : color.red, text_size = size.tiny)

    array<int> displaySlots = array.from(0, 1, 6, 2, 3, 4, 5)
    for rIdx = 0 to 6
        int sSlot = array.get(displaySlots, rIdx)
        int nTf = array.get(permTfTotal, sSlot)
        float tpTf = nTf > 0 ? 100.0 * array.get(permTfTp, sSlot) / nTf : 0.0
        float prTf = nTf > 0 ? 100.0 * array.get(permTfProf, sSlot) / nTf : 0.0
        float exTf = nTf > 0 ? array.get(permTfNetR, sSlot) / nTf : 0.0
        int rowT = rIdx + 2
        table.cell(statsTbl, 0, rowT, f_slot_name(sSlot), text_color = color.white, text_size = size.tiny)
        table.cell(statsTbl, 1, rowT, str.tostring(nTf), text_color = color.white, text_size = size.tiny)
        table.cell(statsTbl, 2, rowT, nTf > 0 ? f_num(tpTf) + "%" : "-", text_color = tpTf >= 70 ? color.lime : color.white, text_size = size.tiny)
        table.cell(statsTbl, 3, rowT, nTf > 0 ? f_num(prTf) + "%" : "-", text_color = color.white, text_size = size.tiny)
        table.cell(statsTbl, 4, rowT, nTf > 0 ? "Aktif" : "-", text_color = color.gray, text_size = size.tiny)
        table.cell(statsTbl, 5, rowT, nTf > 0 ? f_signed_r(exTf) + " (Total " + f_signed_r(array.get(permTfNetR, sSlot)) + ")" : "-", text_color = exTf >= 0 ? color.lime : color.orange, text_size = size.tiny)

