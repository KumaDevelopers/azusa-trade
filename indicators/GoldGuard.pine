    bool localS = ((e20 <= e20s[3] and c < e20 and (e20 <= e50 + 0.15 * a or c < e200) and (dm0[1] >= dp0[1] or ownTrendX == -1)) or (horizon >= 2 and c < e20 and c < e50 and dm0[1] > dp0[1]) or fastReclaimDnX) and not opposingSurgeUpX and not macroBullCushionX
    // Enter early in the wave near EMA10/EMA20! If a candle is already stretched (> 0.65 ATR from EMA10 or range > 1.25 ATR), arm a 1-4 bar pullback/inside-pause entry so we get a better price and hit TP easily!
