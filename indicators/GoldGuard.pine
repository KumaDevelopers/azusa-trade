    bool macroBullCushionX = c > e200 and e200 >= nz(e200s[5], e200) and ((c - e200) <= 2.4 * a or (not na(zoneSupportX) and (c - zoneSupportX) <= 0.90 * a))
    bool macroBearCeilingX = c < e200 and e200 <= nz(e200s[5], e200) and ((e200 - c) <= 2.4 * a or (not na(zoneResistanceX) and (zoneResistanceX - c) <= 0.90 * a))
