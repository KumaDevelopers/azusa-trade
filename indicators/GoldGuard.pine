    bool postImpulsePullB = bar_index > armedPullBarB and bar_index - armedPullBarB <= 4 and l >= armedPullLoB - 0.25 * a and l <= e10 + 0.28 * a and c > e10 and (cleanB or (c > o and lowerW >= 0.28 * cr)) and not overextendedBarB and not opposingSurgeDnX
    bool postImpulsePullS = bar_index > armedPullBarS and bar_index - armedPullBarS <= 4 and h <= armedPullHiS + 0.25 * a and h >= e10 - 0.28 * a and c < e10 and (cleanS or (c < o and upperW >= 0.28 * cr)) and not overextendedBarS and not opposingSurgeUpX
