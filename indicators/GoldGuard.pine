// Shared label constructor retains geometry, style, size, alignment and tooltip.
f_label(int xX, float yX, string captionX, string locX = xloc.bar_index, string styleX = label.style_label_left, color colX = color.gray, string sizeX = size.tiny, string alignX = text.align_center, string hintX = "") =>
    label.new(xX, yX, captionX, xloc = locX, style = styleX, color = colX, textcolor = color.white, size = sizeX, textalign = alignX, tooltip = hintX)

f_dir(float fast, float slow, float price) =>
    fast > slow and price > fast ? 1 : fast < slow and price < fast ? -1 : 0
f_num(float x) =>
    na(x) ? "n/a" : str.tostring(x, "#.##")
f_price(float x) =>
    na(x) ? "-" : str.tostring(x, format.mintick)
f_round(float x) =>
    math.round(x / syminfo.mintick) * syminfo.mintick
f_levels(float entryX, float tpX, float slX) =>
    "E " + f_price(entryX) + "\nTP " + f_price(tpX) + " | SL " + f_price(slX)
f_adverse_r(int sideX, float entryX, float slX, float pxX) =>
    float riskX = math.abs(slX - entryX)
    float adverseX = sideX == 1 ? entryX - pxX : sideX == -1 ? pxX - entryX : 0.0
    riskX > syminfo.mintick ? math.max(0.0, adverseX) / riskX : 0.0

f_defense_now(int sideX, float entryX, float slX, int horizonX, int fastSideX, float fastScoreX, float pxX, int htfRefX) =>
    float cutR = horizonX == 1 ? scalpDefenseR : horizonX == 2 ? intradayDefenseR : swingDefenseR
    bool oppositeFast = mtfBreakoutDefense and sideX != 0 and fastSideX != 0 and fastSideX == -sideX and fastScoreX >= goodScoreMin
    // v1.23.0: the next higher timeframe turning against the trade is also an analytical invalidation.
    bool htfAgainst = mtfBreakoutDefense and sideX != 0 and htfRefX == -sideX
    barstate.isconfirmed and oppositeFast and htfAgainst and f_adverse_r(sideX, entryX, slX, pxX) >= cutR
f_newsWindow(bool enabled, int eventTime) =>
    enabled and time_close >= eventTime - newsBefore * 60000 and time < eventTime + newsAfter * 60000


f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))
f_tier(float score) =>
    score >= goldenScoreMin ? "GOLDEN" : score >= goodScoreMin ? "GOOD" : "NORMAL"
f_horizon_name(int horizon) =>
    horizon == 1 ? "SCALP M5-M15" : horizon == 2 ? "INTRADAY M30-H4" : "SWING D1-W1"


bool isGold = instrument == "Gold USD" or (instrument == "Auto" and (str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")) and syminfo.currency == "USD")
float atr = ta.atr(14)
float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
float rsi = ta.rsi(close, 14)
float vwap = ta.vwap(hlc3)
[dxy, dxyEMA, dxyTime] = request.security(dxySymbol, tf1, [close[1], ta.ema(close, 20)[1], time_close[1]], lookahead = timeframe.in_seconds(tf1) >= timeframe.in_seconds() ? barmerge.lookahead_on : barmerge.lookahead_off, ignore_invalid_symbol = true, calc_bars_count = 400)
[bondYield, yieldEMA, yieldTime] = request.security(yieldSymbol, tf1, [close[1], ta.ema(close, 20)[1], time_close[1]], lookahead = timeframe.in_seconds(tf1) >= timeframe.in_seconds() ? barmerge.lookahead_on : barmerge.lookahead_off, ignore_invalid_symbol = true, calc_bars_count = 400)
bool macroFresh = not na(dxy) and time_close - dxyTime < 72 * 3600000
bool yieldFresh = not na(bondYield) and time_close - yieldTime < 72 * 3600000
int usdRelation = macroRelation == "Inverse" ? -1 : macroRelation == "Direct" ? 1 : macroRelation == "Off" ? 0 : isGold or syminfo.currency == "USD" ? -1 : syminfo.basecurrency == "USD" ? 1 : 0
float macroBias = useMacro and macroFresh ? math.sign(dxy - dxyEMA) * usdRelation : 0
if useMacro and isGold and yieldFresh and usdRelation != 0
    macroBias := (macroBias - math.sign(bondYield - yieldEMA)) / 2
// v1.23.0: daily macro proxy for INTRADAY/SWING confluence (DXY and US10Y versus their own EMA20).
[dxyD, dxyDEMA, dxyDTime] = request.security(dxySymbol, "D", [close[1], ta.ema(close, 20)[1], time_close[1]], lookahead = timeframe.in_seconds("D") >= timeframe.in_seconds() ? barmerge.lookahead_on : barmerge.lookahead_off, ignore_invalid_symbol = true, calc_bars_count = 300)
[yieldD, yieldDEMA, yieldDTime] = request.security(yieldSymbol, "D", [close[1], ta.ema(close, 20)[1], time_close[1]], lookahead = timeframe.in_seconds("D") >= timeframe.in_seconds() ? barmerge.lookahead_on : barmerge.lookahead_off, ignore_invalid_symbol = true, calc_bars_count = 300)
bool macroDFresh = not na(dxyD) and time_close - dxyDTime < 100 * 3600000
bool yieldDFresh = not na(yieldD) and time_close - yieldDTime < 100 * 3600000
float macroBiasD = useMacro and macroDFresh ? math.sign(dxyD - dxyDEMA) * usdRelation : 0
if useMacro and isGold and yieldDFresh and usdRelation != 0
    macroBiasD := (macroBiasD - math.sign(yieldD - yieldDEMA)) / 2

// Chart overlays only; native zone/state engines below own signal decisions.
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)
float resistance = ta.valuewhen(not na(ph), ph, 0)
float support = ta.valuewhen(not na(pl), pl, 0)
bool sweepUp = barstate.isconfirmed and low < support and close > support and close > open
bool sweepDown = barstate.isconfirmed and high > resistance and close < resistance and close < open
bool newsWindow = f_newsWindow(news1, newsTime1) or f_newsWindow(news2, newsTime2) or f_newsWindow(news3, newsTime3)


f_mtf_life_ms(int horizon) =>
    horizon == 1 ? scalpSignalHours * 3600000 : horizon == 2 ? intradaySignalHours * 3600000 : swingSignalDays * 86400000

// Causal bar-touch evaluator with gap-open priority, slippage on stop fills, and conservative SL priority on ambiguous dual-touch bars.
f_touch_bar(int sideX, float slX, float tpX, float oX, float hX, float lX) =>
    bool validX = sideX != 0 and not na(slX) and not na(tpX) and not na(hX) and not na(lX)
    bool slHitX = validX and (sideX == 1 ? lX <= slX : hX >= slX)
    bool tpHitX = validX and (sideX == 1 ? hX >= tpX : lX <= tpX)
    bool gapSLX = validX and not na(oX) and (sideX == 1 ? oX <= slX : oX >= slX)
    bool gapTPX = validX and not na(oX) and (sideX == 1 ? oX >= tpX : oX <= tpX)
    // Code: 1 = TP, -1 = SL, 2 = Dual Touch (conservative SL priority unless resolved by LTF sub-bars)
    int codeX = gapSLX ? -1 : gapTPX ? 1 : slHitX and tpHitX ? 2 : slHitX ? -1 : tpHitX ? 1 : 0
    float stopSlipX = sideX * slippagePrice
    float fillX = gapSLX ? (oX - stopSlipX) : gapTPX ? oX : (slHitX and tpHitX) ? (slX - stopSlipX) : slHitX ? (slX - stopSlipX) : tpHitX ? tpX : na
    [codeX, fillX]


f_setup_name(int methodX) =>
    var array<string> namesX = str.split("CLASSIC|PULLBACK|FAST EMA|BREAKOUT|CANDLE|SWEEP|MOMENTUM|2-CANDLE|RETEST|HL/LH|RANGE|TRENDLINE|VWAP", "|")
    array.get(namesX, methodX >= 1 and methodX <= 12 ? methodX : 0)

// Ranking uses ONLY already-resolved native outcomes. It neither replaces
// the entry guards nor forces a quota of signals for an enabled method.
f_candidate_rank(float qualityX, float netRRX, int countX, float netX, int streakX) =>
    float historyPenaltyX = countX >= 3 ? math.min(16.0, math.max(0.0, -netX / math.max(countX, 1)) * 9.0 + streakX * 3.0) : streakX * 3.0
    qualityX + math.min(4.0, math.max(0.0, netRRX - classicMinNetRR) * 4.0) - historyPenaltyX

// Causal method evaluation: only resolved native plans enter these statistics.
// A pause never removes already-recorded losses or chooses with future outcomes.
f_method_bad(int nX, float winsX, float netX, int streakX) =>
    streakX >= perfLossStreak or (nX >= math.min(perfMinSamples, perfWindow) and 100.0 * winsX / math.max(nX, 1) < perfMinWinrate and netX < 0)

f_method_gate(int nX, float winsX, float netX, int streakX, int untilX, int nowX, int barMsX, float qualityX) =>
    bool badX = f_method_bad(nX, winsX, netX, streakX)
    bool pausedX = learnMethods and nowX < untilX
    bool probeX = learnMethods and badX and not pausedX
    // Recover causally after the fixed pause; old bad results cannot impose an
    // unreachable score forever. Losses remain in the rolling sample.
    float recoveryX = untilX > 0 ? math.max(0.0, (nowX - untilX) / math.max(float(barMsX), 1.0)) : 0.0
    float probeFloorX = mode == "Strict" ? 76.0 : adaptiveFrequency and mode == "Active" ? 68.0 : 72.0
    float probeRequiredX = math.max(probeFloorX, perfProbeScore - recoveryX * (perfProbeScore - probeFloorX) / math.max(perfPauseBars, 1))
    not pausedX and (not probeX or qualityX >= probeRequiredX)

f_record_method(int methodX, float resultRX, int nowX, int barMsX, array<float> ringX, array<int> countX, array<int> headX, array<float> winsX, array<float> netX, array<int> streakX, array<int> untilX) =>
    if methodX >= 1 and methodX <= 12 and not na(resultRX)
        int kX = methodX - 1
        int nX = array.get(countX, kX)
        int headV = array.get(headX, kX)
        int ix = kX * perfWindow + headV
        float removedX = nX >= perfWindow ? array.get(ringX, ix) : 0.0
        float newNet = array.get(netX, kX) - removedX + resultRX
        float newWins = array.get(winsX, kX) - (nX >= perfWindow and removedX > 0 ? 1 : 0) + (resultRX > 0 ? 1 : 0)
        int newCount = math.min(perfWindow, nX + 1)
        int newStreak = resultRX < 0 ? array.get(streakX, kX) + 1 : 0
        array.set(ringX, ix, resultRX)
        array.set(headX, kX, (headV + 1) % perfWindow)
        array.set(countX, kX, newCount)
        array.set(winsX, kX, newWins)
        array.set(netX, kX, newNet)
        array.set(streakX, kX, newStreak)
        if learnMethods and resultRX < 0 and f_method_bad(newCount, newWins, newNet, newStreak)
            array.set(untilX, kX, nowX + perfPauseBars * barMsX)
    0

f_candle_patterns(float cX, float oX, float hX, float lX, float pcX, float poX, float phX, float plX, float ppcX, float ppoX, float pphX, float pplX, float atrX) =>
    float rangeX = math.max(hX - lX, syminfo.mintick)
    float bodyX = math.abs(cX - oX)
    float upperX = hX - math.max(oX, cX)
    float lowerX = math.min(oX, cX) - lX
    float priorBodyX = math.abs(pcX - poX)
    bool hammerX = lowerX >= math.max(2.0 * bodyX, 0.50 * rangeX) and upperX <= 0.22 * rangeX and cX >= lX + 0.65 * rangeX
    bool starX = upperX >= math.max(2.0 * bodyX, 0.50 * rangeX) and lowerX <= 0.22 * rangeX and cX <= lX + 0.35 * rangeX
    bool engulfB = cX > oX and pcX < poX and oX <= pcX + 0.03 * atrX and cX >= poX and bodyX >= 0.25 * atrX
    bool engulfS = cX < oX and pcX > poX and oX >= pcX - 0.03 * atrX and cX <= poX and bodyX >= 0.25 * atrX
    bool morningX = ppcX < ppoX and priorBodyX < 0.5 * math.abs(ppcX - ppoX) and cX > oX and cX > (ppoX + ppcX) * 0.5 and bodyX >= 0.2 * atrX
    bool eveningX = ppcX > ppoX and priorBodyX < 0.5 * math.abs(ppcX - ppoX) and cX < oX and cX < (ppoX + ppcX) * 0.5 and bodyX >= 0.2 * atrX
    // Piercing/dark-cloud allow an FX-style open near the previous close.
    bool piercingX = pcX < poX and cX > oX and oX <= pcX + 0.05 * atrX and cX > (poX + pcX) * 0.5 and cX < poX and bodyX >= 0.2 * atrX
    bool cloudX = pcX > poX and cX < oX and oX >= pcX - 0.05 * atrX and cX < (poX + pcX) * 0.5 and cX > poX and bodyX >= 0.2 * atrX
    bool haramiB = pcX < poX and cX > oX and oX > pcX and cX < poX and bodyX < priorBodyX * 0.65
    bool haramiS = pcX > poX and cX < oX and oX < pcX and cX > poX and bodyX < priorBodyX * 0.65
    bool tweezerB = math.abs(lX - plX) <= 0.12 * atrX and pcX < poX and cX > oX and lowerX >= 0.25 * rangeX
    bool tweezerS = math.abs(hX - phX) <= 0.12 * atrX and pcX > poX and cX < oX and upperX >= 0.25 * rangeX
    bool soldiersX = cX > oX and pcX > poX and ppcX > ppoX and cX > pcX and pcX > ppcX and oX >= poX and oX <= pcX and poX >= ppoX and poX <= ppcX and bodyX >= 0.2 * atrX and upperX <= 0.25 * rangeX
    bool crowsX = cX < oX and pcX < poX and ppcX < ppoX and cX < pcX and pcX < ppcX and oX <= poX and oX >= pcX and poX <= ppoX and poX >= ppcX and bodyX >= 0.2 * atrX and lowerX <= 0.25 * rangeX
    [hammerX, starX, engulfB, engulfS, morningX, eveningX, piercingX, cloudX, haramiB, haramiS, tweezerB, tweezerS, soldiersX, crowsX]

// S/R helpers: nearest level strictly above / below a reference price.
// Bounded equivalent loops replace four unrolled tests in each S/R helper.
// Missing levels and strict above/below comparisons match v1.23.14.
f_near_level(int sideX, float refX, float v1, float v2, float v3, float v4) =>
    float bestX = na
    for vX in array.from(v1, v2, v3, v4)
        if not na(vX) and sideX * (vX - refX) > 0 and (na(bestX) or sideX * (vX - bestX) < 0)
            bestX := vX
    bestX
f_near_above(float refX, float v1, float v2, float v3, float v4) =>
    f_near_level(1, refX, v1, v2, v3, v4)
f_near_below(float refX, float v1, float v2, float v3, float v4) =>
    f_near_level(-1, refX, v1, v2, v3, v4)
f_cluster_anchor(int sideX, float anchorX, float atrX, float v1, float v2, float v3, float v4) =>
    float outX = anchorX
    float reachX = srClusterATR * atrX
    for vX in array.from(v1, v2, v3, v4)
        if not na(vX) and sideX * (anchorX - vX) >= -0.15 * atrX and sideX * (anchorX - vX) <= reachX
            outX := sideX == 1 ? math.min(outX, vX) : math.max(outX, vX)
    outX

// Extend a scalp anchor only to nearby, held native structure. No future pivots.
f_scalp_anchor(int sideX, float anchorX, float pullLoX, float pullHiX, float nearX, float farX, float aX) =>
    float outX = sideX == 1 ? math.min(anchorX, pullLoX) : math.max(anchorX, pullHiX)
    if not na(nearX) and not na(farX) and sideX * (nearX - farX) >= 0 and math.abs(nearX - outX) <= srClusterATR * aX
        outX := sideX == 1 ? math.min(outX, farX) : math.max(outX, farX)
    outX

f_setup_plan(int sideX, int methodX, float qualityX, float entryX, float anchorX, float atrX, float wallX, float stretchX, float candleRangeX, int horizonX) =>
    float minD = (horizonX == 1 ? scalpMinPips : horizonX == 2 ? intradayMinPips : swingMinPips) * goldPipSize
    // Apply adaptive ATR risk floor across ALL timeframes (M5 through W1) so fixed pip floors never inflate SL/TP distance.
    if adaptiveRiskFloor and (adaptiveFrequency or mode != "Strict")
        minD := math.min(minD, (horizonX == 1 ? 0.75 : horizonX == 2 ? 0.85 : 0.95) * atrX)
    float atrMult = horizonX == 1 ? scalpStopATR + (timeframe.in_seconds() <= 300 ? scalpM5ExtraATR : 0.0) : horizonX == 2 ? intradayStopATR : swingStopATR
    float baseBufferX = horizonX == 1 and scalpStructureSL ? math.max(srBufferATR, scalpSLBufferATR) : srBufferATR
    float wickNoiseX = math.min(0.15, math.max(0.0, candleRangeX / atrX - 1.0) * 0.10)
    float bufferX = (baseBufferX + wickNoiseX) * atrX
    float structDistX = math.max(0.0, sideX * (entryX - anchorX))
    // Keep structural SL span tight and proportional to the current swing (1.35-2.00 ATR) so TP is close enough to get hit on the very first impulse wave!
    float maxAnchorSpanX = (horizonX == 1 ? 1.35 : horizonX == 2 ? 1.70 : 2.10) * atrX
    float effectiveStructX = math.min(structDistX, maxAnchorSpanX)
    float riskX = math.max(minD, math.max(atrMult * atrX, effectiveStructX + bufferX))
    float rawStopX = entryX - sideX * riskX
    float slX = (sideX == 1 ? math.floor(rawStopX / syminfo.mintick) : math.ceil(rawStopX / syminfo.mintick)) * syminfo.mintick
    riskX := math.abs(entryX - slX)
    float maxHorizonRiskATR = horizonX == 1 ? math.min(classicMaxRiskATR, 2.40) : horizonX == 2 ? math.min(classicMaxRiskATR, 2.90) : classicMaxRiskATR
    bool activeScalpX = horizonX == 1 and adaptiveFrequency and mode == "Active"
    float minNetX = activeScalpX ? scalpMinNetRR : horizonX == 2 ? math.min(classicMinNetRR, 1.10) : math.min(classicMinNetRR, 1.15)
    // Cost-adjusted floor; do not advertise RR that is only valid before costs.
    if methodX == 3 or methodX == 8
        minNetX := math.max(minNetX, breakMinRR)
    // Snappy wave-fitted target RR so trades hit WIN TP directly instead of stalling and reversing into TRAIL/BE.
    float rrX = activeScalpX ? (methodX == 10 ? math.min(scalpTargetR, 1.12) : scalpTargetR) : methodX == 10 ? 1.15 : methodX == 6 ? 1.22 : horizonX == 2 ? 1.22 : 1.30
    float minRewardX = minNetX * (riskX + costPrice) + costPrice
    float maxReachATR = (horizonX == 1 ? 1.65 : horizonX == 2 ? 2.15 : 2.70) * atrX
    float targetRewardX = math.min(rrX * riskX, math.max(minRewardX + syminfo.mintick, maxReachATR))
    float rewardX = math.max(targetRewardX, minRewardX + syminfo.mintick)
    // Only clamp reward to wallX when wallX still leaves at least minRewardX room; otherwise let the setup target minRewardX unless wallX is closer than srMinRoomATR.
    if guardZones and not na(wallX) and sideX * (wallX - entryX) > 0
        float wallRoomX = math.max(0.0, sideX * (wallX - entryX) - 0.15 * atrX)
        if wallRoomX >= minRewardX
            rewardX := math.min(rewardX, wallRoomX)
    float tpX = f_round(entryX + sideX * rewardX)
    float netX = (sideX * (tpX - entryX) - costPrice) / math.max(riskX + costPrice, syminfo.mintick)
    float maxStretchX = methodX == 5 or methodX == 10 ? 2.10 : methodX == 6 ? (horizonX == 1 ? scalpMomentumMaxStretch : momentumFastATR) : horizonX == 1 and scalpEntryGuard ? scalpChaseATR : 1.85
    float requiredQX = 52.0 // Model-specific threshold belongs to the router.
    bool planOKX = true
    if na(atrX) or atrX <= 0 or na(anchorX) or na(entryX)
        planOKX := false
    else if qualityX < requiredQX
        planOKX := false
    else if candleRangeX > (horizonX == 1 and scalpEntryGuard ? scalpCandleATR : horizonX == 1 ? 2.6 : 3.2) * atrX or stretchX > maxStretchX
        planOKX := false
    else if riskX > maxHorizonRiskATR * atrX
        planOKX := false
    else if costPrice > riskX * 0.25
        planOKX := false
    else if guardZones and not na(wallX) and sideX * (wallX - entryX) > 0 and sideX * (wallX - entryX) < srMinRoomATR * atrX
        planOKX := false
    else if sideX * (entryX - slX) <= 0 or sideX * (tpX - entryX) <= 0 or netX + 0.000001 < minNetX
        planOKX := false
    [planOKX, slX, tpX, netX]

f_native_probability(float trendX, float pressureX, float exhaustionX, float structureX, float reactionX, float roomX, bool chopX) =>
    // Multi-bar structure, exhaustion and target room describe the next leg.
    // No single candle's colour is used as a direction forecast.
    float signedX = 0.20 * trendX + 0.10 * pressureX + 0.10 * exhaustionX + 0.25 * structureX + 0.20 * reactionX + 0.15 * roomX
    f_clamp(50.0 + 38.0 * signedX * (chopX ? 0.65 : 1.0), 15.0, 85.0)

f_pattern_text(bool bull, bool hammer, bool star, bool engulfB, bool engulfS, bool morning, bool evening, bool piercing, bool cloud, bool haramiB, bool haramiS, bool tweezerB, bool tweezerS, bool soldiers, bool crows) =>
    string t = ""
    array<bool> flags = bull ? array.from(hammer, engulfB, morning, piercing, haramiB, tweezerB, soldiers) : array.from(star, engulfS, evening, cloud, haramiS, tweezerS, crows)
    array<string> names = str.split(bull ? "Hammer|Engulf B|Morning star|Piercing|Bull harami|Tweezer bottom|3 soldiers" : "Shooting star|Engulf S|Evening star|Dark cloud|Bear harami|Tweezer top|3 crows", "|")
    for i = 0 to 6
        if array.get(flags, i)
            t += (t == "" ? "" : "\n") + array.get(names, i)
    t

f_method_explanation(int m) =>
    var array<string> captionsX = str.split("Candle|Pullback EMA20/zona|Reclaim EMA10/20|Break 2 close/retest|Pola di zona|Sweep reclaim + MSS|Impuls setelah base/pullback|Dua candle + reclaim|Retest zona/mikro|HL/LH terkonfirmasi|Range rejection|Trendline + struktur|VWAP reclaim", "|")
    array.get(captionsX, m >= 1 and m <= 12 ? m : 0)

// Shared native-zone engine. All inputs are from the previous CLOSED candle.
// kind 0 = pivot/reaction S/R; kind 1 = compact base + displacement S/D.
type GGZone
    int side
    float lo
    float hi
    float a
    int born
    int kind = 0
    int tests = 1
    float reaction = 0.0
    bool armed = false
    bool touched = false
    int touchedAt = 0
    int tested = 0
    int lastSeen = 0
    int farBars = 0
    int outside = 0
    bool impulse = false
    int acceptedAt = 0
    bool dormant = false
    bool retestExpired = false
    float acceptedGrade = 0.0
    int flips = 0
    string role = ""
    string origin = ""

f_zone_strength(GGZone z) =>
    z.kind == 1 ? math.max(25.0, 85.0 + 5.0 * math.min(z.reaction, 3) - 15.0 * math.max(0, z.tests - 1)) : math.max(z.tests >= strengthTests ? strongZoneMin : 0.0, math.min(95.0, 30.0 + 14.0 * math.min(z.tests, 4) + 10.0 * math.min(z.reaction, 2)))
f_zone_is_strong(GGZone z) =>
    z.kind == 1 ? z.tests <= 2 and f_zone_strength(z) >= strongZoneMin : z.tests >= strengthTests
f_zone_name(GGZone z) =>
    z.kind == 1 ? (z.side == 1 ? "DEMAND" : "SUPPLY") : z.role != "" ? z.role : z.side == 1 ? "SUPPORT" : "RESISTANCE"
f_zone_status(GGZone z) =>
    z.dormant ? "ARSIP / TUNGGU REAKSI" : z.retestExpired ? "BREAK LAMA / TUNGGU REAKSI" : z.acceptedAt > 0 ? "BREAK / TUNGGU RETEST" : z.outside > 0 ? "UJI TEMBUS " + str.tostring(z.outside) + "/" + str.tostring(breakCloses) : z.kind == 1 ? (z.tests == 1 ? "FRESH" : "MITIGATED " + str.tostring(z.tests - 1)) : f_zone_is_strong(z) ? "KUAT" : "LEMAH"

f_add_zone(array<GGZone> zones, int side, float lo, float hi, float a, int now, int kind, float reaction) =>
    bool merged = false
    if not na(lo) and not na(hi) and hi > lo and a > 0
        for z in zones
            // Never move boundaries after a breach has started. No automatic role change.
            if not z.dormant and z.kind == kind and z.side == side and z.acceptedAt == 0 and z.outside == 0 and lo <= z.hi + 0.10 * a and hi >= z.lo - 0.10 * a and math.max(hi, z.hi) - math.min(lo, z.lo) <= 0.85 * a
                if kind == 0
                    z.lo := math.min(z.lo, lo)
                    z.hi := math.max(z.hi, hi)
                    z.reaction := math.max(z.reaction, reaction)
                merged := true
                break
        if not merged
            if array.size(zones) >= 96
                int removeAt = 0
                int oldest = now
                bool sleepingFound = false
                for j = 0 to array.size(zones) - 1
                    GGZone candidate = array.get(zones, j)
                    if candidate.dormant and (not sleepingFound or candidate.lastSeen < oldest)
                        sleepingFound := true
                        oldest := candidate.lastSeen
                        removeAt := j
                array.remove(zones, removeAt)
            GGZone z = GGZone.new(side, lo, hi, a, now)
            z.kind := kind
            z.reaction := reaction
            z.lastSeen := now
            z.tested := now
            array.push(zones, z)
    0

f_update_zones(array<GGZone> zones, int now, int barMs, float c, float o, float h, float l, float a) =>
    int breakSide = 0
    float breakLo = na
    float breakHi = na
    float breakGrade = 0.0
    int retestSide = 0
    float retestLo = na
    float retestHi = na
    float supportMid = na
    float supportLo = na
    float resistanceMid = na
    float resistanceHi = na
    float reactionBias = 0.0
    float retestGrade = 0.0
    if array.size(zones) > 0 and not na(a) and a > 0
        for i = array.size(zones) - 1 to 0
            GGZone z = array.get(zones, i)
            float scale = math.max(a, z.a)
            bool touch = l <= z.hi and h >= z.lo
            float departure = z.side == 1 ? c - z.hi : z.lo - c
            bool outside = z.side == 1 ? c < z.lo - breakBuffer * scale : c > z.hi + breakBuffer * scale
            bool reclaim = z.side == 1 ? c > z.hi + breakBuffer * scale : c < z.lo - breakBuffer * scale
            float cr = math.max(h - l, syminfo.mintick)
            bool impulsive = -z.side * (c - o) >= breakBody * a and (z.side == 1 ? c <= l + 0.30 * cr : c >= h - 0.30 * cr)
            // A sleeping S/R may hold on the touch candle or its next 4 candles.
            if z.dormant and z.kind == 0 and touch and not z.touched
                z.touched := true
                z.touchedAt := now
            bool recentArchiveTouch = z.touched and now - z.touchedAt <= 4 * barMs
            bool revivedHold = z.dormant and z.kind == 0 and (touch or recentArchiveTouch) and departure >= 0.35 * scale and z.side * (c - o) >= 0.10 * a and (z.side == 1 ? c >= l + 0.60 * cr : c <= l + 0.40 * cr)
            if revivedHold
                z.dormant := false
                z.acceptedAt := 0
                z.retestExpired := false
                z.outside := 0
                z.impulse := false
                z.farBars := 0
                z.flips := 0
                if now - z.tested >= 3 * barMs
                    z.tests += 1
                    z.tested := now
                z.reaction := math.max(z.reaction, departure / scale)
                z.armed := false
                z.touched := false
                reactionBias := z.side
            if touch
                z.lastSeen := now
            z.outside := outside ? z.outside + 1 : 0
            z.impulse := outside ? z.impulse or impulsive : false
            bool justAccepted = (not z.dormant or recentArchiveTouch) and z.acceptedAt == 0 and z.outside >= breakCloses and z.impulse
            if justAccepted
                z.dormant := false
                z.acceptedAt := now
                z.retestExpired := false
                z.acceptedGrade := f_zone_is_strong(z) ? f_zone_strength(z) : -f_zone_strength(z)
                z.armed := false
                z.touched := false
                float distance = z.side == 1 ? z.lo - c : c - z.hi
                float oldDistance = na(breakLo) ? 1e10 : breakSide == 1 ? c - breakHi : breakLo - c
                if breakSide == 0 or (z.acceptedGrade > 0 and breakGrade <= 0) or ((z.acceptedGrade > 0) == (breakGrade > 0) and distance < oldDistance)
                    breakSide := -z.side
                    breakLo := z.lo
                    breakHi := z.hi
                    breakGrade := z.acceptedGrade
            bool retest = z.acceptedAt > 0 and now > z.acceptedAt and touch and outside and -z.side * (c - o) >= 0.15 * a and (z.side == 1 ? c <= l + 0.40 * cr : c >= l + 0.60 * cr) and (z.side == 1 ? h <= z.hi + 0.35 * scale : l >= z.lo - 0.35 * scale)
            if retest
                float originalGrade = z.acceptedGrade
                if z.kind == 1
                    z.origin := z.side == 1 ? "ex DEMAND" : "ex SUPPLY"
                z.side := -z.side
                z.kind := 0
                z.role := z.side == 1 ? "RBS" : "SBR"
                z.flips := z.retestExpired or z.dormant ? 1 : z.flips + 1
                z.dormant := false
                z.farBars := 0
                z.acceptedAt := 0
                z.retestExpired := false
                z.outside := 0
                z.impulse := false
                z.tests := 1
                z.reaction := math.max(0.0, (z.side == 1 ? c - z.hi : z.lo - c) / scale)
                z.tested := now
                z.touched := false
                z.armed := false
                if retestSide == 0 or (originalGrade > 0 and retestGrade <= 0) or ((originalGrade > 0) == (retestGrade > 0) and math.abs(originalGrade) > math.abs(retestGrade))
                    retestSide := z.side
                    retestLo := z.lo
                    retestHi := z.hi
                    retestGrade := originalGrade
            else if not z.dormant and reclaim and z.acceptedAt > 0
                // Failed breakout: restore original role, no flip and no deleted loss.
                z.acceptedAt := 0
                z.retestExpired := false
                z.outside := 0
                z.impulse := false
                z.armed := false
            if not z.dormant and not revivedHold and not retest and z.acceptedAt == 0 and z.outside == 0
                if z.armed and touch
                    z.touched := true
                    z.touchedAt := now
                    z.armed := false
                if z.touched and now - z.touchedAt <= 4 * barMs and departure >= 0.35 * scale and now - z.tested >= 3 * barMs
                    z.tests += 1
                    z.tested := now
                    z.touched := false
                    z.reaction := math.max(z.reaction, departure / scale)
                    reactionBias := z.side
                if z.touched and now - z.touchedAt > 4 * barMs
                    z.touched := false
                if now - z.tested <= 4 * barMs
                    z.reaction := math.max(z.reaction, math.max(0.0, departure / scale))
                if not touch and departure >= 0.50 * scale and not z.touched
                    z.armed := true
            float dist = math.max(z.lo - c, c - z.hi) / scale
            z.farBars := dist > zoneInvalidATR and not touch ? z.farBars + 1 : 0
            bool expiredBreak = z.acceptedAt > 0 and now - z.acceptedAt > flipWindow * barMs
            z.retestExpired := expiredBreak
            bool invalid = z.farBars >= zoneInvalidBars or z.flips >= zoneMaxFlips or (not f_zone_is_strong(z) and now - z.lastSeen > zoneWeakAge * barMs and dist > 3) or expiredBreak
            if invalid and not touch and not revivedHold
                z.dormant := true
                z.armed := false
                if not recentArchiveTouch
                    z.touched := false
            else if not z.dormant and z.acceptedAt == 0 and z.outside == 0 and f_zone_is_strong(z)
                if z.side == 1 and z.hi < c and (na(supportMid) or z.hi > supportMid)
                    supportMid := z.hi
                    supportLo := z.lo
                if z.side == -1 and z.lo > c and (na(resistanceMid) or z.lo < resistanceMid)
                    resistanceMid := z.lo
                    resistanceHi := z.hi
    [breakSide, breakLo, breakHi, retestSide, retestLo, retestHi, supportMid, supportLo, resistanceMid, resistanceHi, reactionBias, retestGrade, breakGrade]

// Entry state is separate from the zone's current SBR/RBS role.
type GGBreakEntry
    int side = 0
    float lo = na
    float hi = na
    float anchor = na
    float confirm = na
    float grade = 0.0
    int retestAt = 0
    bool retested = false
    bool fired = false

f_break_entry(GGBreakEntry p, int now, int barMs, int rawBreak, float rawLo, float rawHi, float rawGrade, int retestSide, float retestLo, float retestHi, float grade, float c, float o, float h, float l, float priorClose, float a, bool trendB, bool trendS, bool regime) =>
    int entrySide = 0
    float entryLo = na
    float entryHi = na
    float entryAnchor = na
    float entryGrade = 0.0
    bool activeZoneX = activeDevelopingZones and adaptiveFrequency and mode == "Active"
    float signalRangeX = math.max(h - l, syminfo.mintick)
    bool developingBreakX = activeZoneX and math.abs(rawGrade) >= 50 and regime and (rawBreak == 1 ? trendB : trendS) and rawBreak * (c - o) >= math.max(breakBody, 0.30) * a and (rawBreak == 1 ? c >= l + 0.65 * signalRangeX : c <= l + 0.35 * signalRangeX)
    bool developingRetestX = activeZoneX and math.abs(grade) >= 50 and regime and (retestSide == 1 ? trendB : trendS)
    if rawBreak != 0
        // A new accepted break creates a new epoch; events need no entry approval.
        p.side := 0
        p.fired := false
        p.retested := false
        p.lo := rawLo
        p.hi := rawHi
        p.grade := math.abs(rawGrade)
        if breakEntryRoute != "Retest saja" and (not breakRequireStrong or rawGrade > 0 or developingBreakX)
            p.side := rawBreak
            p.anchor := rawBreak == 1 ? rawLo : rawHi
            p.confirm := rawBreak == 1 ? rawHi : rawLo
            p.retestAt := now
    if retestSide != 0
        bool alreadyUsed = p.fired and p.lo == retestLo and p.hi == retestHi
        if not alreadyUsed and (not breakRequireStrong or grade > 0 or developingRetestX)
            p.side := retestSide
            p.lo := retestLo
            p.hi := retestHi
            p.anchor := retestSide == 1 ? math.min(retestLo, l) : math.max(retestHi, h)
            p.confirm := retestSide == 1 ? h : l
            p.grade := math.abs(grade)
            p.retestAt := now
            p.retested := true
            p.fired := false
    if p.side != 0
        float edge = p.side == 1 ? p.hi : p.lo
        float cr = math.max(h - l, syminfo.mintick)
        bool expired = now - p.retestAt > breakConfirmBars * barMs
        bool failed = p.side * (c - edge) < -0.05 * a
        bool afterTrigger = p.retested ? now > p.retestAt : now >= p.retestAt
        bool follow = afterTrigger and p.side * (c - p.confirm) > (p.retested ? 0.03 : breakBuffer) * a and p.side * (c - priorClose) > 0
        bool clean = p.side * (c - o) >= math.max(p.retested ? 0.20 : breakBody, minBodyATR) * a and (p.side == 1 ? c >= l + 0.65 * cr : c <= l + 0.35 * cr)
        bool spike = cr > breakMaxCandle * a or math.abs(o - priorClose) > 0.35 * a
        bool chase = p.side * (c - edge) > breakChase * a
        bool trend = p.side == 1 ? trendB : trendS
        if expired or failed
            p.side := 0
        else if afterTrigger
            if follow and clean and not spike and not chase and trend and regime
                entrySide := p.side
                entryLo := p.lo
                entryHi := p.hi
                entryAnchor := p.anchor
                entryGrade := p.grade
                p.side := 0
                p.fired := true
    [entrySide, entryLo, entryHi, entryAnchor, entryGrade]

f_pack_zones(array<GGZone> zones) =>
    string txt = ""
    // Transport only the current map. Historical lifecycle remains native.
    if bar_index >= last_bar_index - 2
        for z in zones
            if not z.dormant
                txt += (txt == "" ? "" : ";") + str.tostring(z.born) + "," + str.tostring(z.side) + "," + str.tostring(z.lo, format.mintick) + "," + str.tostring(z.hi, format.mintick) + "," + str.tostring(f_zone_strength(z), "#") + "," + f_zone_name(z) + "," + f_zone_status(z) + "," + str.tostring(z.tests) + "," + str.tostring(z.acceptedAt) + "," + (z.origin == "" ? "-" : z.origin) + "," + (f_zone_is_strong(z) ? "1" : "0")
    txt


// History exists only in the chart call. Frozen records are visual context.
type GGZoneHistory
    int zoneBorn
    int side
    float lo
    float hi
    int first
    int last
    int seen
    string name
    bool active = true

f_update_zone_history(array<GGZoneHistory> history, array<GGZone> zones, int now) =>
    for z in zones
        if z.kind == 0 and f_zone_is_strong(z) and not z.dormant and z.acceptedAt == 0
            int match = -1
            if array.size(history) > 0
                for i = array.size(history) - 1 to 0
                    GGZoneHistory r = array.get(history, i)
                    if r.active and r.zoneBorn == z.born and r.side == z.side and r.name == f_zone_name(z) and r.lo == z.lo and r.hi == z.hi
                        match := i
                        break
            if match >= 0
                GGZoneHistory r = array.get(history, match)
                r.last := now
                r.seen := now
            else
                array.push(history, GGZoneHistory.new(z.born, z.side, z.lo, z.hi, now, now, now, f_zone_name(z)))
    // A confirmed break or sleep ends the old interval at its known close.
    // A later revival creates a new interval; it never fills the intervening gap.
    for r in history
        if r.active and r.seen != now
            r.active := false
            r.last := now
    while array.size(history) > 128
        int removeAt = 0
        for i = 0 to array.size(history) - 1
            GGZoneHistory r = array.get(history, i)
            if not r.active
                removeAt := i
                break
        array.remove(history, removeAt)
    0

type GGMarkerGate
    int lastBar = -1000000
    int side = 0
    float lo = na
    float hi = na

f_break_marker(GGMarkerGate gate, bool enabled, int side, float grade, float lo, float hi, float a, int nowBar) =>
    int out = 0
    if enabled and side != 0 and grade > 0 and not na(a) and a > 0
        int age = nowBar - gate.lastBar
        bool sameBand = gate.side == side and not na(gate.lo) and lo <= gate.hi + 0.20 * a and hi >= gate.lo - 0.20 * a
        bool duplicate = sameBand and age < 3 * breakMarkerSpacing
        if age >= breakMarkerSpacing and not duplicate
            out := side
            gate.lastBar := nowBar
            gate.side := side
            gate.lo := lo
            gate.hi := hi
    out

f_zone_snapshot(array<GGZoneHistory> zoneHistoryX = na) =>
    // One bounded zone pool in each evaluated timeframe context.
    int srcTime = time_close[1]
    float c = close[1]
    float o = open[1]
    float h = high[1]
    float l = low[1]
    float a = ta.atr(14)[1]
    float bd = math.abs(c - o)
    float cr = math.max(h - l, syminfo.mintick)
    bool cleanB = c > o and c >= l + 0.60 * cr
    bool cleanS = c < o and c <= l + 0.40 * cr
    float phX = ta.pivothigh(high, pivotLen, pivotLen)[1]
    float plX = ta.pivotlow(low, pivotLen, pivotLen)[1]
    int nativeMsX = int(timeframe.in_seconds() * 1000)
    var array<GGZone> zonesX = array.new<GGZone>()
    [brSideX, brLoX, brHiX, rtSideX, rtLoX, rtHiX, zoneSupportX, zoneSupportLoX, zoneResistanceX, zoneResistanceHiX, zoneReactionX, rtGradeX, brGradeX] = f_update_zones(zonesX, srcTime, nativeMsX, c, o, h, l, a)
    // Pivot S/R: confirmed swing reaction; a candidate is weak until repeat tests.
    float pivotAtrX = ta.atr(14)[pivotLen + 1]
    float rightHiX = ta.highest(high[1], pivotLen + 1)
    float rightLoX = ta.lowest(low[1], pivotLen + 1)
    if not na(plX) and c > plX
        f_add_zone(zonesX, 1, plX, plX + 0.18 * pivotAtrX, pivotAtrX, srcTime, 0, math.max(0.0, (rightHiX - plX) / pivotAtrX))
    if not na(phX) and c < phX
        f_add_zone(zonesX, -1, phX - 0.18 * pivotAtrX, phX, pivotAtrX, srcTime, 0, math.max(0.0, (phX - rightLoX) / pivotAtrX))
    // S/D has a DIFFERENT detector: 1-3 compact base candles + displacement.
    int baseN = 0
    float baseHi = na
    float baseLo = na
    for k = 2 to 4
        bool compact = high[k] - low[k] <= 0.85 * a and math.abs(close[k] - open[k]) <= 0.45 * a
        if compact and baseN == k - 2
            baseN += 1
            baseHi := na(baseHi) ? high[k] : math.max(baseHi, high[k])
            baseLo := na(baseLo) ? low[k] : math.min(baseLo, low[k])
    if baseN > 0 and baseHi - baseLo <= 1.10 * a and bd >= sdImpulse * a
        if cleanB and c > baseHi + breakBuffer * a
            f_add_zone(zonesX, 1, baseLo, baseHi, a, srcTime, 1, (c - baseHi) / a)
        if cleanS and c < baseLo - breakBuffer * a
            f_add_zone(zonesX, -1, baseLo, baseHi, a, srcTime, 1, (baseLo - c) / a)
    if not na(zoneHistoryX)
        f_update_zone_history(zoneHistoryX, zonesX, srcTime)
    [brSideX, brLoX, brHiX, rtSideX, rtLoX, rtHiX, zoneSupportX, zoneSupportLoX, zoneResistanceX, zoneResistanceHiX, zoneReactionX, rtGradeX, brGradeX, f_pack_zones(zonesX)]

// Context is sampled INSIDE the signal timeframe, never using host-chart [1].
// Every requested series is offset once. These requests are evaluated on every
// native bar, including history, before their values are latched at entry.
f_closed_context_trend() =>
    float e20X = ta.ema(close, 20)
    float e50X = ta.ema(close, 50)
    float hiX = ta.highest(high[1], 6)
    float loX = ta.lowest(low[1], 6)
    bool upX = close > e20X and e20X > e20X[2] and (e20X > e50X or (allowTrendShift and close > hiX))
    bool downX = close < e20X and e20X < e20X[2] and (e20X < e50X or (allowTrendShift and close < loX))
    int sideX = upX ? 1 : downX ? -1 : 0
    [sideX[1], time_close[1]]

f_native_context(int asOfX, int horizonX) =>
    float secX = timeframe.in_seconds()
    string parent1X = secX <= 300 ? "15" : secX <= 900 ? "60" : secX <= 3600 ? "240" : secX <= 14400 ? "D" : "W"
    string parent2X = secX <= 300 ? "60" : secX <= 900 ? "240" : secX <= 3600 ? "D" : "W"
    [p1X, t1X] = request.security(syminfo.tickerid, parent1X, f_closed_context_trend(), lookahead = barmerge.lookahead_on, calc_bars_count = 700)
    [p2X, t2X] = request.security(syminfo.tickerid, parent2X, f_closed_context_trend(), lookahead = barmerge.lookahead_on, calc_bars_count = 700)
    // Macro source must also be at least as high as the native timeframe.
    // Intraday/swing use daily context, or weekly on W1. No single-intrabar LTF sampling.
    bool alignedMacroX = timeframe.in_seconds(tf1) >= secX and timeframe.in_seconds(tf1) % secX == 0
    string macroTFX = horizonX == 1 ? (alignedMacroX ? tf1 : "60") : secX <= 86400 ? "D" : timeframe.period
    [usdX, usdEMAX, usdTX] = request.security(dxySymbol, macroTFX, [close[1], ta.ema(close, 20)[1], time_close[1]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = 400)
    [yieldX, yieldEMAX, yieldTX] = request.security(yieldSymbol, macroTFX, [close[1], ta.ema(close, 20)[1], time_close[1]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = 400)
    int r1X = not na(t1X) and t1X <= asOfX ? nz(p1X) : 0
    int r2X = not na(t2X) and t2X <= asOfX ? nz(p2X) : 0
    int maxAgeX = int(math.max(100 * 3600000.0, timeframe.in_seconds(macroTFX) * 2000.0))
    bool usdOKX = useMacro and usdRelation != 0 and not na(usdX) and not na(usdEMAX) and not na(usdTX) and usdTX <= asOfX and asOfX - usdTX < maxAgeX
    bool yieldOKX = useMacro and isGold and usdRelation != 0 and not na(yieldX) and not na(yieldEMAX) and not na(yieldTX) and yieldTX <= asOfX and asOfX - yieldTX < maxAgeX
    int countX = (usdOKX ? 1 : 0) + (yieldOKX ? 1 : 0)
    float totalX = (usdOKX ? math.sign(usdX - usdEMAX) * usdRelation : 0.0) + (yieldOKX ? -math.sign(yieldX - yieldEMAX) : 0.0)
    [r1X, r2X, countX > 0 ? totalX / countX : 0.0, countX]

// Confluence score 0-100 + veto reason ("" = pass).
// 40% own-TF technical quality, 30% higher-TF agreement, 20% macro proxy (DXY / US10Y), 10% price location.
f_context_verdict(int horX, int sideX, float qX, float posX, int bornX, int methodX, int r1, int r2, float macroRaw) =>
    bool breakTradeX = methodX == 3 or methodX == 8
    float v1 = r1 == sideX ? 1.0 : r1 == 0 ? 0.3 : -1.0
    float v2 = r2 == sideX ? 1.0 : r2 == 0 ? 0.3 : -1.0
    float htf = 0.6 * v1 + 0.4 * v2
    float macS = sideX * nz(macroRaw, 0.0)
    float ps = sideX == 1 ? posX : 1.0 - posX
    bool localScalp = horX == 1 and (methodX == 4 or methodX == 5 or methodX == 10 or methodX == 11) and nz(qX) >= 76
    bool adaptiveHTFX = contextPolicy == "Adaptif" and nz(qX) >= 80
    float locS = na(ps) ? 0.0 : ps <= 0.60 ? 1.0 : ps <= 0.80 ? 0.4 : ps <= 0.92 ? -0.1 : -0.7
    if multiSetup and contextPolicy == "Adaptif" and (na(ps) or ps <= 0.90)
        locS := math.max(locS, 0.3) // Do not penalize normal trend continuation on M5-W1 unless at >90% extreme range edge.
    int hUtc = hour(bornX, "UTC")
    bool rollover = sessionFilter and (hour(bornX, "America/New_York") == 17 or hour(bornX, "America/New_York") == 16 and minute(bornX, "America/New_York") >= 45)
    bool thinAsia = sessionFilter and hUtc < 7 and methodX != 10
    float score = 40.0 * nz(qX, 0.0) / 100.0 + 30.0 * (htf + 1.0) / 2.0 + 20.0 * (macS + 1.0) / 2.0 + 10.0 * (locS + 1.0) / 2.0
    if contextPolicy == "Adaptif"
        score := 0.80 * nz(qX, 0.0) + 12.0 * (htf + 1.0) / 2.0 + 3.0 * (macS + 1.0) / 2.0 + 5.0 * (locS + 1.0) / 2.0
    score := score - (thinAsia and horX == 1 ? 2.0 : 0.0)
    score := math.max(0.0, math.min(100.0, score))
    string why = ""
    if outputTrendGuard and r1 == -sideX and r2 == -sideX
        why := "OUTPUT: dua TF atas lawan"
    else if htfVeto and r1 == -sideX and (horX == 1 or (not localScalp and not adaptiveHTFX))
        why := "TF atas lawan"
    else if macroVeto and useMacro and (horX >= 2 or (breakTradeX and not (adaptiveFrequency and mode == "Active" and contextPolicy == "Adaptif"))) and macS <= -0.99
        why := "Makro lawan"
    else if rollover and horX == 1
        why := "Rollover"
    else if ((news1 and bornX >= newsTime1 - newsBefore * 60000 and bornX <= newsTime1 + newsAfter * 60000) or (news2 and bornX >= newsTime2 - newsBefore * 60000 and bornX <= newsTime2 + newsAfter * 60000) or (news3 and bornX >= newsTime3 - newsBefore * 60000 and bornX <= newsTime3 + newsAfter * 60000)) and horX <= 2
        why := "Jendela news"
    else if (not multiSetup or contextPolicy == "Ketat") and horX >= 2 and not na(ps) and ps > 0.95
        why := "Kejar harga"
    else if score < ctxMinScore
        why := "Skor rendah"
    [score, why]

type GGNativeState
    int srcTime
    int bias
    int sig
    float q
    int liveSide
    int liveBorn
    float liveEntry
    float liveSL
    float liveTP
    float liveQ
    float livePos
    int resBorn
    int resTime
    int resCode
    int resSide
    float resE
    float resSL
    float resTP
    float resQ
    float resPos
    float resPrice
    int liveMethod
    int resMethod
    float biasUp
    string liveNote
    string resNote
    string zoneMap
    float initialSL = na
    float liveContext = na
    string liveWhy = ""
    float resContext = na
    string resWhy = ""
    int stopMovedAt = 0
    int liveRegime = 0
    int resRegime = 0

f_failed_break(int methodX, int sideX, int ageX, int barMsX, float loX, float hiX, float cX, float aX) =>
    bool outsideX = sideX == 1 ? cX < hiX - breakBuffer * aX : cX > loX + breakBuffer * aX
    bool outsidePriorX = sideX == 1 ? close[2] < hiX - breakBuffer * aX : close[2] > loX + breakBuffer * aX
    sideX != 0 and ageX > 0 and (methodX == 3 or methodX == 8) and ageX <= breakFailureBars * barMsX and outsideX and (timeframe.in_seconds() > 900 or outsidePriorX)

f_mtf_native_state() =>
    // Evaluated INSIDE the requested context, never from the chart or loop index.
    // M5/M15 = scalp, H1/H4 = intraday, D1/W1 = swing (same as v1.23.11).
    int horizon = timeframe.in_seconds() <= 900 ? 1 : timeframe.in_seconds() <= 14400 ? 2 : 3
    var array<float> methodRing = array.new<float>(12 * perfWindow, 0.0)
    var array<int> methodCount = array.new<int>(12, 0)
    var array<int> methodHead = array.new<int>(12, 0)
    var array<float> methodWins = array.new<float>(12, 0.0)
    var array<float> methodNet = array.new<float>(12, 0.0)
    var array<int> methodStreak = array.new<int>(12, 0)
    var array<int> methodUntil = array.new<int>(12, 0)
    // Signal discovery stays on the previous CLOSED native-timeframe candle.
    // This avoids repainting entries, while a separate live-touch layer below
    // invalidates an already-active signal as soon as its current bar hits SL/TP.
    int srcTime = time_close[1]
    float c = close[1]
    float o = open[1]
    float h = high[1]
    float l = low[1]
    float atrSeriesX = ta.atr(14)
    float a = atrSeriesX[1]
    float atr2X = atrSeriesX[2]
    float atr3X = atrSeriesX[3]
    float e10s = ta.ema(close, 10)
    float e20s = ta.ema(close, 20)
    float e50s = ta.ema(close, 50)
    float e200s = ta.ema(close, 200)
    float e10 = e10s[1]
    float e20 = e20s[1]
    float e50 = nz(e50s[1], e20s[1])
    float e200 = nz(e200s[1], e50)
    float vwapSeriesX = ta.vwap(hlc3)
    float rsiSeriesX = ta.rsi(close, 14)
    float rs = rsiSeriesX[1]
    float rs2X = rsiSeriesX[2]
    float rs3X = rsiSeriesX[3]
    [dp0, dm0, ax0] = ta.dmi(14, 14)
    float ax = ax0[1]
    bool activeX = adaptiveFrequency and mode == "Active"
    float cr = math.max(h - l, syminfo.mintick)
    float bd = math.abs(c - o)
    float upperW = h - math.max(o, c)
    float lowerW = math.min(o, c) - l
    float p4h = ta.highest(high[2], 4)
    float p4l = ta.lowest(low[2], 4)
    float p6h = ta.highest(high[2], 6)
    float p6l = ta.lowest(low[2], 6)
    bool bullStack = c > e20 and e20 > e50 and e20 > e20s[3]
    bool bearStack = c < e20 and e20 < e50 and e20 < e20s[3]
    bool shiftUpX = allowTrendShift and c > p6h and c > e20 and e20 > e20s[3]
    bool shiftDownX = allowTrendShift and c < p6l and c < e20 and e20 < e20s[3]
    int ownTrendX = bullStack or shiftUpX ? 1 : bearStack or shiftDownX ? -1 : 0
    int bias = ownTrendX
