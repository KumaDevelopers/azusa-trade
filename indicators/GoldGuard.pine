    float downLineX = not na(prevHighBarX) and wallHighX < prevHighX ? wallHighX + (wallHighX - prevHighX) * (bar_index - 1 - wallHighBarX) / math.max(1, wallHighBarX - prevHighBarX) : na
    float upLineX = not na(prevLowBarX) and wallLowX > prevLowX ? wallLowX + (wallLowX - prevLowX) * (bar_index - 1 - wallLowBarX) / math.max(1, wallLowBarX - prevLowBarX) : na
