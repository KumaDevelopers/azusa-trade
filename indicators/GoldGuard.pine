    bool locationB = emaTouchB or goldenB or deepB or demandB or postImpulsePullB or (horizon >= 2 and l <= e10 + 0.25 * a and c > e10)
    bool locationS = emaTouchS or goldenS or deepS or supplyS or postImpulsePullS or (horizon >= 2 and h >= e10 - 0.25 * a and c < e10)
