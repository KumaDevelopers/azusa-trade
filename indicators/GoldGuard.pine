        bool impulseBreakdownCutX = smartCutLoss and not canStillProfitX and adverseCloseRX >= smartCutMinR and wrongSideEma10And20X and (opposingImpulseBarX or opposingSignalFiredX or (againstMacroEma200X and e10SlopingAgainstX) or (adverseCloseRX >= 0.52 and e10SlopingAgainstX))
        bool smartCutNowX = impulseBreakdownCutX
        // [C] Early Stale Exit (Blue EXIT STALE): trade is stagnating in loss (open >= 30% of life or >= 4 bars, never reached +0.35R, and sitting on wrong side of EMA20 in drawdown >= 0.18R) -> exit as STALE instead of waiting to get hit by SL!
        bool earlyLossStaleX = smartCutLoss and not canStillProfitX and (ageMsX >= int(baseLifeMsX * 0.30) or ageMsX >= 4 * nativeMsX) and livePeakR < 0.35 and adverseCloseRX >= 0.18 and twoBarsWrongEma20X
        bool failedBreakX = not reverseOutput and not canStillProfitX and f_failed_break(liveMethod, liveSide, ageMsX, nativeMsX, liveBreakLoX, liveBreakHiX, c, a) and wrongSideEma10And20X
        bool runnerAlignedX = closeRX >= 0.25 and (liveSide == 1 ? c > e20 : c < e20)
        // Extend life up to 1.35x if the trade is profitable and trending; or trigger early STALE if stagnating in loss!
        bool stale = earlyLossStaleX or ageMsX >= (runnerAlignedX ? int(baseLifeMsX * 1.35) : baseLifeMsX)
        if slHit or tpHit or failedBreakX or flipped or smartCutNowX or stale
            // Export the resolution so the host chart can build the daily ledger.
            // Code: 1 TP, -1 SL, 2 STRUCTURE (blue), 3 STALE, 4 FAILED BREAK (blue), 5 TRAIL/BE, 6 CUT LOSS (blue).
            resBorn := liveBorn
            resTime := srcTime
            [nativeHitX, nativeFillX] = f_touch_bar(liveSide, liveSL, liveTP, o, h, l)
            bool movedStopX = liveSide * (liveSL - liveInitialSL) > syminfo.mintick * 0.5
            // If time expires while already protected by a profitable moved stop or > +0.50R close, classify as TRAIL/BE profit lock instead of STALE.
            bool profitableExpiryX = stale and nativeHitX == 0 and (movedStopX or closeRX >= 0.50)
            // Honest fill price: stop/market exits pay 1-way slippagePrice; never cap Cut-Loss price artificially!
            float marketExitFillX = c - liveSide * slippagePrice
            float prelimExitPxX = nativeHitX != 0 ? nativeFillX : marketExitFillX
            float prelimNetRX = (liveSide * (prelimExitPxX - liveEntry) - costPrice) / originalRiskX
            // Distinguish exit reason from financial outcome: a moved stop is only TRAIL/BE (5) if it improved upon initial SL; if SL was hit first, never label it as CUT LOSS!
            resCode := nativeHitX == -1 or nativeHitX == 2 ? (movedStopX ? 5 : -1) : nativeHitX == 1 ? 1 : failedBreakX ? 4 : smartCutNowX ? 6 : flipped ? 2 : (profitableExpiryX and prelimNetRX > 0) ? 5 : 3
            resPrice := prelimExitPxX
            lastExitTime := srcTime
            resSide := liveSide
            resMethod := liveMethod
            resRegime := liveRegime
            resNote := liveNote
            resContext := liveContext
            resWhy := liveWhy
            float methodResultR = (liveSide * (resPrice - liveEntry) - costPrice) / originalRiskX
            f_record_method(liveMethod, methodResultR, srcTime, int(tfSecX * 1000), methodRing, methodCount, methodHead, methodWins, methodNet, methodStreak, methodUntil)
            resE := liveEntry
            resSL := liveInitialSL
            resTP := liveTP
            resQ := liveQ
            resPos := livePos
            // Only count full red SL hits (resCode == -1) toward heavy loss-streak circuit breakers; controlled blue early cuts allow agile re-entry!
            if resCode == -1 and liveSide * (resPrice - liveEntry) - costPrice < -0.05 * originalRiskX
                totalLossStreakX += 1
                sideLossCountX := liveSide == lastSLSide ? sideLossCountX + 1 : 1
                scalpRearmX := false
                lastSLTime := srcTime
                lastSLSide := liveSide
                lastSLPrice := liveEntry
                lastSLMethod := liveMethod
            else if resCode == 2 or resCode == 3 or resCode == 4 or resCode == 6
                // For a blue Smart Cut-Loss, record failed zone so we don't re-enter same side at same failed price, while allowing opposite reversal!
                lastSLTime := srcTime
                lastSLSide := liveSide
                lastSLPrice := liveEntry
                lastSLMethod := liveMethod
            else if liveSide * (resPrice - liveEntry) - costPrice > 0.05 * originalRiskX
                totalLossStreakX := 0
                sideLossCountX := 0
                scalpRearmX := true
            liveSide := 0
            liveBorn := na
            liveEntry := na
            liveSL := na
            liveTP := na
            livePeakR := 0.0
            liveMaxAdverseR := 0.0
            liveQ := na
            livePos := na
            justResolved := true

        else
            // Evaluate OLD stop first; these new levels apply only to subsequent bars.
            // Let winning trades breathe so they hit WIN TP! Only lock BE when price has already come close to TP (>= beAtR = 0.82R or >= 0.88R intrabar) AND momentum stalls/pauses!
            bool momentumStallingInProfitX = -liveSide * (c - o) > 0 or liveSide * (c - e10) < 0 or ageMsX >= int(baseLifeMsX * 0.55)
            bool nearTpTouchLockX = barBestRX >= 0.88 and closeRX >= 0.35
            bool recoveredDeepDrawdownX = liveMaxAdverseR >= 0.45 and closeRX >= 0.65 and momentumStallingInProfitX
            if manageBE and (nearTpTouchLockX or recoveredDeepDrawdownX or ((closeRX >= beAtR or livePeakR >= beAtR) and closeRX >= 0.40 and momentumStallingInProfitX))
                float lockOffsetX = costPrice + beLockR * originalRiskX
                float beX = liveEntry + liveSide * lockOffsetX
                // Keep at least 0.35 ATR breathing room behind current close so normal wicks don't stop out the trade before TP!
                float maxSafeBeX = c - liveSide * 0.35 * a
                beX := liveSide == 1 ? math.min(beX, maxSafeBeX) : math.max(beX, maxSafeBeX)
                if liveSide * (beX - (liveEntry + liveSide * costPrice)) >= 0
                    liveSL := liveSide == 1 ? math.max(liveSL, beX) : math.min(liveSL, beX)
            if manageTrail and (closeRX >= trailAtR or (livePeakR >= trailAtR and closeRX >= 0.65)) and momentumStallingInProfitX
                float structuralTrailX = liveSide == 1 ? p4l - srBufferATR * a : p4h + srBufferATR * a
                float atrTrailX = c - liveSide * trailATR * a
                float candidateTrailX = liveSide == 1 ? math.max(structuralTrailX, atrTrailX) : math.min(structuralTrailX, atrTrailX)
                float safeBoundX = c - liveSide * 0.40 * a
                candidateTrailX := liveSide == 1 ? math.min(candidateTrailX, safeBoundX) : math.max(candidateTrailX, safeBoundX)
                if liveSide * (candidateTrailX - (liveEntry + liveSide * costPrice)) >= 0
                    liveSL := liveSide == 1 ? math.max(liveSL, candidateTrailX) : math.min(liveSL, candidateTrailX)
            float prevSLX = liveSL
            liveSL := f_round(liveSL)
            if math.abs(liveSL - prevSLX) >= syminfo.mintick * 0.5
                liveStopMovedAt := srcTime

    // Loss reset uses only a subsequent CLOSED native candle + clean pullback/base.
    bool scalpResetTouchX = (c < o and l <= e10 + 0.15 * a) or (c > o and h >= e10 - 0.15 * a) or scalpBaseX
    int nativeBarMs = int(timeframe.in_seconds() * 1000.0)
    int streakWaitBars = horizon == 1 ? streakPauseBars : math.max(1, int(math.ceil(streakPauseBars * 0.5)))
    int anyLossWaitMs = (totalLossStreakX >= 2 ? streakWaitBars : 1) * nativeBarMs
    if not scalpRearmX and not na(lastSLTime) and srcTime > lastSLTime and (scalpResetTouchX or srcTime - lastSLTime >= f_mtf_life_ms(1))
        scalpRearmX := true
    outputSignalX := reverseOutput ? -sig : sig
    // After 1 SL: wait at least 1 bar for opposite side, or lossSideBars for same side. After >=2 consecutive SLs: pause BOTH sides for streakWaitBars!
    bool anyLossCooling = not na(lastSLTime) and srcTime - lastSLTime < anyLossWaitMs
    bool scalpRetryBlockedX = scalpGuardX and not scalpRearmX and (sideLossCountX >= 2 and outputSignalX == lastSLSide or totalLossStreakX >= 2)
    int cooldownBarsX = horizon == 1 ? lossSideBars : activeX ? 1 : horizon == 2 ? 2 : 1
    int sameSideWaitMs = cooldownBarsX * nativeBarMs + (sideLossCountX >= 2 ? streakWaitBars * nativeBarMs : 0)
    bool sameSideBlocked = sameSideWaitMs > 0 and not na(lastSLTime) and outputSignalX == lastSLSide and srcTime - lastSLTime < sameSideWaitMs
    // Spatial Anti-Repeat SL Guard: do not repeat the same direction in the same price zone (or same method) within 8 bars of an SL unless price broke out >= 0.55 ATR beyond the failed entry!
    bool recentFailedZoneX = not na(lastSLTime) and not na(lastSLPrice) and outputSignalX == lastSLSide and srcTime - lastSLTime < 8 * nativeBarMs
    bool clearedFailedZoneX = outputSignalX == 1 ? c >= lastSLPrice + 0.55 * a or l <= e50 : c <= lastSLPrice - 0.55 * a or h >= e50
    bool sameZoneRepeatBlockedX = recentFailedZoneX and (math.abs(c - lastSLPrice) <= 0.85 * a or chosenMethod == lastSLMethod) and not clearedFailedZoneX
    bool exitCooling = not na(lastExitTime) and srcTime - lastExitTime < cooldown * 60000
    // Never re-arm on the exact same bar after a stop-loss (resCode == -1); allow same-bar re-arm after TP/TRAIL/BE win.
    bool closeRearmX = justResolved and (horizon == 1 or activeX) and cooldown == 0 and ((resCode == 1 or resCode == 5) and totalLossStreakX == 0 or (resCode == 2 or resCode == 3 or resCode == 4 or resCode == 6) and outputSignalX == -resSide)
    bool resolutionWaitX = justResolved and not closeRearmX
    int lastResetX = outputSignalX == 1 ? lastSetupResetB : lastSetupResetS
    bool eventSetupX = (chosenMethod == 3 or chosenMethod == 8 or chosenMethod == 10 or chosenMethod == 11) and totalLossStreakX < 2
    bool resetAfterEntryX = not na(lastResetX) and (na(lastSignalTime) or lastResetX > lastSignalTime)
    bool flowSpacingX = scalpFreshSetup and horizon == 1 and outputSignalX == lastSignalSide and not eventSetupX and not na(lastSignalTime) and not resetAfterEntryX
    bool reverseRiskOK = not reverseOutput or (math.abs(c - candidateSL) - costPrice) / math.max(math.abs(candidateTP - c) + costPrice, syminfo.mintick) >= classicMinNetRR
    bool nativeSessionOK = not useSession or not na(time(timeframe.period, sessionHours, tz)[1])
    if not na(srcTime) and liveSide == 0 and not resolutionWaitX and not flowSpacingX and sig != 0 and not anyLossCooling and not sameSideBlocked and not sameZoneRepeatBlockedX and not scalpRetryBlockedX and not exitCooling and nativeSessionOK and reverseRiskOK and srcTime >= startTest and not na(candidateSL) and not na(candidateTP)
        liveSide := outputSignalX
        liveBorn := srcTime
        lastSignalTime := srcTime
        lastSignalSide := outputSignalX
        lastSignalEntry := c
        liveEntry := c
        liveSL := reverseOutput ? candidateTP : candidateSL
        liveTP := reverseOutput ? candidateSL : candidateTP
        liveInitialSL := liveSL
        livePeakR := 0.0
        liveMaxAdverseR := 0.0
        liveAnchorX := reverseOutput ? liveSL + liveSide * (horizon == 1 ? scalpSLBufferATR : srBufferATR) * a : candidateAnchor
        liveQ := signalQ
        liveMethod := chosenMethod
        [entryContextX, entryWhyX] = f_context_verdict(horizon, liveSide, signalQ, pos, srcTime, chosenMethod, birthParent1X, birthParent2X, birthMacroX)
        liveContext := entryContextX
        liveWhy := entryWhyX
        bool microEntryX = chosenMethod == 8 and (liveSide == 1 ? microB and not retestB : microS and not retestS)
        float microEdgeX = liveSide == 1 ? testedMicroB : testedMicroS
        liveBreakLoX := microEntryX ? microEdgeX - 0.10 * a : chosenMethod == 3 or chosenMethod == 8 ? breakEntryLoX : na
        liveBreakHiX := microEntryX ? microEdgeX + 0.10 * a : chosenMethod == 3 or chosenMethod == 8 ? breakEntryHiX : na
        if chosenMethod == 5
            if liveSide == 1
                sweptAtB := na
            else
                sweptAtS := na
        if liveSide == 1
            armedPullBarB := -1000
        else
            armedPullBarS := -1000
        if microEntryX
            if liveSide == 1
                microLevelB := na
            else
                microLevelS := na
        string relevantPatterns = liveSide == 1 ? patternsB : patternsS
        string contraryPatterns = liveSide == 1 ? patternsS : patternsB
        liveNote := (relevantPatterns == "" ? "Pola: -" : relevantPatterns) + (contraryPatterns != "" ? "\nLawan: " + contraryPatterns : "") + (reverseOutput ? "\nREVERSE dari " + (sig == 1 ? "BUY" : "SELL") : "") + "\nSetup: " + f_method_explanation(chosenMethod) + "\nSkor skenario B " + f_num(biasUp) + " / S " + f_num(100 - biasUp) + " (skor)"
        if chosenMethod == 3
            liveNote += "\nZona break " + f_price(breakEntryLoX) + "–" + f_price(breakEntryHiX) + (breakPlanX.retested ? " | retest | zona " : " | 2 close | zona ") + f_num(breakGradeX)

        liveNote += "\nRezim: " + (currentRegimeX == 1 ? "TREND" : currentRegimeX == 2 ? "RANGE" : "TRANSITION") + " | Proxy: " + (birthMacroCountX == 0 ? "data kosong" : birthMacroX > 0 ? "bullish" : birthMacroX < 0 ? "bearish" : "campuran")
        livePos := pos
        liveRegime := currentRegimeX
        liveStopMovedAt := srcTime

    // ===== INTRABAR / DEVELOPING BAR [0] IMMEDIATE TP & SL MONITOR =====
    // Evaluates ONLY when the developing bar [0] opened AT OR AFTER liveBorn (time >= liveBorn) AND after the last stop update (time >= liveStopMovedAt).
    // Never uses high/low from the entry bar itself or from before a stop move!
    if liveSide != 0 and not na(liveBorn) and time >= liveBorn and time >= liveStopMovedAt
        [curHitX, curFillX] = f_touch_bar(liveSide, liveSL, liveTP, open, high, low)
        if curHitX != 0
            float origRiskCurX = math.max(math.abs(liveEntry - liveInitialSL), syminfo.mintick)
            bool movedStopCurX = liveSide * (liveSL - liveInitialSL) > syminfo.mintick * 0.5
            resBorn := liveBorn
            resTime := math.min(time_close, timenow)
            resCode := curHitX == -1 or curHitX == 2 ? (movedStopCurX ? 5 : -1) : 1
            resPrice := curFillX
            lastExitTime := resTime
            resSide := liveSide
            resMethod := liveMethod
            resRegime := liveRegime
            resNote := liveNote
            resContext := liveContext
            resWhy := liveWhy
            float curResultRX = (liveSide * (resPrice - liveEntry) - costPrice) / origRiskCurX
            f_record_method(liveMethod, curResultRX, resTime, int(tfSecX * 1000), methodRing, methodCount, methodHead, methodWins, methodNet, methodStreak, methodUntil)
            resE := liveEntry
            resSL := liveInitialSL
            resTP := liveTP
            resQ := liveQ
            resPos := livePos
            if resCode == -1 and curResultRX < -0.05
                totalLossStreakX += 1
                sideLossCountX := liveSide == lastSLSide ? sideLossCountX + 1 : 1
                scalpRearmX := false
                lastSLTime := resTime
                lastSLSide := liveSide
                lastSLPrice := liveEntry
                lastSLMethod := liveMethod
            else if curResultRX > 0.05
                totalLossStreakX := 0
                sideLossCountX := 0
                scalpRearmX := true
            liveSide := 0
            liveBorn := na
            liveEntry := na
            liveSL := na
            liveTP := na
            livePeakR := 0.0
            liveMaxAdverseR := 0.0
            liveQ := na
            livePos := na

    GGNativeState resultX = GGNativeState.new(srcTime, bias, sig, q, liveSide, liveBorn, liveEntry, liveSL, liveTP, liveQ, livePos, resBorn, resTime, resCode, resSide, resE, resSL, resTP, resQ, resPos, resPrice, liveMethod, resMethod, biasUp, liveNote, resNote, zoneMapX, liveInitialSL)
    resultX.liveContext := liveContext
    resultX.liveWhy := liveWhy
    resultX.resContext := resContext
    resultX.resWhy := resWhy
    resultX.stopMovedAt := liveStopMovedAt
    resultX.liveRegime := liveRegime
    resultX.resRegime := resRegime
    resultX

// Compact UDT transport: closed native state, including immutable original risk.
// Higher TF uses the previous native candle; lower TF returns all available samples.
f_native_packet() =>
    GGNativeState p = f_mtf_native_state()
    p.sig := reverseOutput ? -p.sig : p.sig
    p

type GGNativeFeed
    GGNativeState packetSec
    array<GGNativeState> packetArr

f_latest_packet(array<GGNativeState> packetsX, GGNativeState fallbackX) =>
    GGNativeState resultX = fallbackX
    if not na(packetsX)
        if array.size(packetsX) > 0
            resultX := array.last(packetsX)
    resultX

f_native_fields(GGNativeState p) =>
    var GGNativeState emptyX = GGNativeState.new()
    GGNativeState v = na(p) ? emptyX : p
    [v.srcTime, v.bias, v.sig, v.q, v.liveSide, v.liveBorn, v.liveEntry, v.liveSL, v.liveTP, v.liveQ, v.livePos]
// Exactly one backend executes for each requested timeframe on every chart bar.
// The native expression is loop-invariant; horizon comes from its native context.
var array<string> nativePeriods = str.split("5|15|60|240|D|W|30", "|")
var array<GGNativeState> retainedNative = array.new<GGNativeState>(7, na)
f_retain_native(int slotX, GGNativeState incomingX) =>
    GGNativeState retainedX = array.get(retainedNative, slotX)
    if not na(incomingX)
        if not na(incomingX.srcTime) and (na(retainedX) or na(retainedX.srcTime) or incomingX.srcTime >= retainedX.srcTime)
            retainedX := incomingX
            array.set(retainedNative, slotX, retainedX)
    retainedX

GGNativeState nativePacketExpr = f_native_packet()
array<GGNativeFeed> nativeFeeds = array.new<GGNativeFeed>()
for nativeSlotX = 0 to 6
    string nativePeriod = array.get(nativePeriods, nativeSlotX)
    GGNativeState packetSecX = na
    array<GGNativeState> packetArrX = na
    if timeframe.in_seconds(nativePeriod) < timeframe.in_seconds()
        packetArrX := request.security_lower_tf(syminfo.tickerid, nativePeriod, nativePacketExpr, ignore_invalid_timeframe = true, calc_bars_count = nativeHistoryBars)
    else
        packetSecX := request.security(syminfo.tickerid, nativePeriod, nativePacketExpr, lookahead = barmerge.lookahead_on, calc_bars_count = nativeHistoryBars)
    // An empty LTF array is a temporary absence, not an exit or cancellation.
    // Keep the most recent native snapshot across host bars. A newer explicit
    // liveSide=0 packet still replaces it, so resolved positions cannot stay ACTIVE.
    GGNativeState incomingX = f_latest_packet(packetArrX, packetSecX)
    GGNativeState retainedX = f_retain_native(nativeSlotX, incomingX)
    array.push(nativeFeeds, GGNativeFeed.new(retainedX, packetArrX))

GGNativeFeed m5Feed = array.get(nativeFeeds, 0)
GGNativeState m5PacketSec = m5Feed.packetSec
array<GGNativeState> m5PacketArr = m5Feed.packetArr
GGNativeState m5Detail = m5PacketSec
[m5T, m5Bias, m5Sig, m5Q, m5Live, m5Born, m5E, m5SL, m5TP, m5LiveQ, m5LPos] = f_native_fields(m5Detail)

GGNativeFeed m15Feed = array.get(nativeFeeds, 1)
GGNativeState m15PacketSec = m15Feed.packetSec
array<GGNativeState> m15PacketArr = m15Feed.packetArr
GGNativeState m15Detail = m15PacketSec
[m15T, m15Bias, m15Sig, m15Q, m15Live, m15Born, m15E, m15SL, m15TP, m15LiveQ, m15LPos] = f_native_fields(m15Detail)

GGNativeFeed h1Feed = array.get(nativeFeeds, 2)
GGNativeState h1PacketSec = h1Feed.packetSec
array<GGNativeState> h1PacketArr = h1Feed.packetArr
GGNativeState h1Detail = h1PacketSec
[h1T, h1BiasMap, h1SigMap, h1Q, h1Live, h1Born, h1E, h1SL, h1TP, h1LiveQ, h1LPos] = f_native_fields(h1Detail)

GGNativeFeed h4Feed = array.get(nativeFeeds, 3)
GGNativeState h4PacketSec = h4Feed.packetSec
array<GGNativeState> h4PacketArr = h4Feed.packetArr
GGNativeState h4Detail = h4PacketSec
[h4T, h4BiasMap, h4SigMap, h4Q, h4Live, h4Born, h4E, h4SL, h4TP, h4LiveQ, h4LPos] = f_native_fields(h4Detail)

GGNativeFeed d1Feed = array.get(nativeFeeds, 4)
GGNativeState d1PacketSec = d1Feed.packetSec
array<GGNativeState> d1PacketArr = d1Feed.packetArr
GGNativeState d1Detail = d1PacketSec
[d1T, d1BiasMap, d1SigMap, d1Q, d1Live, d1Born, d1E, d1SL, d1TP, d1LiveQ, d1LPos] = f_native_fields(d1Detail)

GGNativeFeed w1Feed = array.get(nativeFeeds, 5)
GGNativeState w1PacketSec = w1Feed.packetSec
array<GGNativeState> w1PacketArr = w1Feed.packetArr
GGNativeState w1Detail = w1PacketSec
[w1T, w1BiasMap, w1SigMap, w1Q, w1Live, w1Born, w1E, w1SL, w1TP, w1LiveQ, w1LPos] = f_native_fields(w1Detail)

GGNativeFeed m30Feed = array.get(nativeFeeds, 6)
GGNativeState m30Detail = m30Feed.packetSec

// Cross-TF Intrabar Monitor: when viewing HTF signals (e.g. H1/H4 on an M15 chart), check if the current host bar (strictly after liveBorn and stopMovedAt) touched TP or SL so status updates immediately!
array<int> hostHits = array.new<int>(7, 0)
array<float> hostHitPrices = array.new<float>(7, na)
for slotHitX = 0 to 6
    GGNativeState detHitX = slotHitX == 0 ? m5Detail : slotHitX == 1 ? m15Detail : slotHitX == 2 ? h1Detail : slotHitX == 3 ? h4Detail : slotHitX == 4 ? d1Detail : slotHitX == 5 ? w1Detail : m30Detail
    if not na(detHitX) and detHitX.liveSide != 0 and not na(detHitX.liveBorn) and time >= detHitX.liveBorn and time >= detHitX.stopMovedAt
        [hCodeX, hFillX] = f_touch_bar(detHitX.liveSide, detHitX.liveSL, detHitX.liveTP, open, high, low)
        if hCodeX != 0
            array.set(hostHits, slotHitX, hCodeX)
            array.set(hostHitPrices, slotHitX, hFillX)

f_slot_detail(int slotX) =>
    slotX == 0 ? m5Detail : slotX == 1 ? m15Detail : slotX == 2 ? h1Detail : slotX == 3 ? h4Detail : slotX == 4 ? d1Detail : slotX == 5 ? w1Detail : m30Detail

// Uses only already-closed macro observations with valid timestamps.
f_macro_at(int horizonX, int asOfX) =>
    bool dailyX = horizonX >= 2
    float usdX = dailyX ? dxyD : dxy
    float usdEMA = dailyX ? dxyDEMA : dxyEMA
    int usdT = dailyX ? dxyDTime : dxyTime
    float yX = dailyX ? yieldD : bondYield
    float yEMA = dailyX ? yieldDEMA : yieldEMA
    int yT = dailyX ? yieldDTime : yieldTime
    bool usdOK = useMacro and usdRelation != 0 and not na(usdX) and not na(usdEMA) and usdT <= asOfX and asOfX - usdT < 100 * 3600000
    bool yOK = useMacro and isGold and usdRelation != 0 and not na(yX) and not na(yEMA) and yT <= asOfX and asOfX - yT < 100 * 3600000
    float totalX = (usdOK ? math.sign(usdX - usdEMA) * usdRelation : 0.0) + (yOK ? -math.sign(yX - yEMA) : 0.0)
    int countX = (usdOK ? 1 : 0) + (yOK ? 1 : 0)
    [countX > 0 ? totalX / countX : 0.0, countX]
f_manual_at(int asOfX) =>
    asOfX >= fundamentalFrom and asOfX <= fundamentalUntil and fundamentalUntil > fundamentalFrom ? (fundamentalView == "Bullish" ? 1.0 : fundamentalView == "Bearish" ? -1.0 : 0.0) : 0.0
f_forward_score(int slotX) =>
    GGNativeState nativeX = f_slot_detail(slotX)
    int parentSlotX = slotX == 0 ? 1 : slotX == 1 or slotX == 6 ? 2 : slotX == 2 ? 3 : slotX == 3 ? 4 : slotX == 4 ? 5 : -1
    GGNativeState parentX = parentSlotX >= 0 ? f_slot_detail(parentSlotX) : na
    int horX = slotX < 2 ? 1 : slotX < 4 or slotX == 6 ? 2 : 3
    int asOfX = time_close[1]
    [macroX, countX] = f_macro_at(horX, asOfX)
    float higherX = na(parentX) ? 0.0 : nz(parentX.biasUp, 50.0) - 50.0
    na(nativeX) or na(nativeX.biasUp) ? na : math.round(f_clamp(nativeX.biasUp + 0.20 * higherX + 8.0 * macroX + fundamentalWeight * f_manual_at(asOfX), 10.0, 90.0))

f_bias_pair(float upX) =>
    na(upX) ? "DATA BELUM CUKUP" : "NAIK " + str.tostring(upX, "#") + " | TURUN " + str.tostring(100.0 - upX, "#")
f_tf_bias_summary() =>
    string txtX = ""
    for slotX = 0 to 6
        GGNativeState dX = f_slot_detail(slotX)
        txtX += "\n" + (slotX == 0 ? "M5" : slotX == 1 ? "M15" : slotX == 2 ? "H1" : slotX == 3 ? "H4" : slotX == 4 ? "D1" : slotX == 5 ? "W1" : "M30") + "  " + f_bias_pair(f_forward_score(slotX))
    txtX

// All discretionary exits now resolve INSIDE the native lifecycle.
array<bool> hostCuts = array.new<bool>(7, false)

// ===== DAILY LEDGER + CONFLUENCE ENGINE (v1.23.0) =====
// One merged ledger for M5/M15/H1/H4/D1/W1. Daily stats use input tz; completed drawings retain the configured history days.
// Technical triggers still come from the canonical native state; the engine below decides whether the trigger is
// ACTIVE (actionable) or SKIP (filtered). Skipped signals keep being tracked, so you can see what the filter avoided.
int ledgerClock = math.min(time_close, timenow)
int dayStartNow = timestamp(tz, year(ledgerClock, tz), month(ledgerClock, tz), dayofmonth(ledgerClock, tz), 0, 0, 0)
var array<string> lgNote = array.new<string>()
var array<int> lgMethod = array.new<int>()
var array<int> lgSlot = array.new<int>()
var array<int> lgBorn = array.new<int>()
var array<int> lgSide = array.new<int>()
var array<float> lgE = array.new<float>()
var array<float> lgSL = array.new<float>()
var array<float> lgTP = array.new<float>()
var array<float> lgCtx = array.new<float>()
var array<int> lgSkip = array.new<int>()
var array<string> lgWhy = array.new<string>()
var array<int> lgRes = array.new<int>() // 0 open, 1 WIN, -1 LOSS/CUT, 2 FLAT (net of costs)
var array<int> lgEnd = array.new<int>()
var array<float> lgR = array.new<float>()
var array<string> lgKind = array.new<string>()
var array<label> lgLbl = array.new<label>()
var array<line> lgLn = array.new<line>()
var array<int> slotLastRes = array.new<int>(7, 0)

f_slot_name(int s) =>
    s == 0 ? "M5" : s == 1 ? "M15" : s == 2 ? "H1" : s == 3 ? "H4" : s == 4 ? "D1" : s == 5 ? "W1" : "M30"
f_slot_hor(int s) =>
    s <= 1 ? 1 : s <= 3 or s == 6 ? 2 : 3
f_signed_r(float x) =>
    (x >= 0 ? "+" : "-") + str.tostring(math.abs(math.round(x, 2))) + "R"

f_lg_find(int slotX, int bornX) =>
    int idx = -1
    int n = array.size(lgBorn)
    if n > 0
        for i = n - 1 to 0
            if array.get(lgSlot, i) == slotX and array.get(lgBorn, i) == bornX
                idx := i
                break
    idx

f_lg_limit_drawings() =>
    int visibleX = 0
    int nX = array.size(lgBorn)
    if nX > 0
        array<int> slotCountsX = array.new<int>(7, 0)
        // Cap M5 (slot 0) and M15 (slot 1) so M30, H1, H4, D1, W1 always retain dedicated visibility slots on the chart.
        int m5CapX = math.max(12, int(visibleHistoryLimit * 0.25))
        int m15CapX = math.max(12, int(visibleHistoryLimit * 0.25))
        array<float> keysX = array.new<float>()
        for iX = 0 to nX - 1
            int sX = array.get(lgSlot, iX)
            // Prioritize higher timeframes in drawing retention so H1/H4/D1/W1 are never evicted by M5 noise.
            float tfWeightX = (sX == 5 ? 6.0 : sX == 4 ? 5.0 : sX == 3 ? 4.0 : sX == 2 ? 3.0 : sX == 6 ? 2.0 : sX == 1 ? 1.0 : 0.0) * 86400000.0 * 3.0
            array.push(keysX, float(array.get(lgBorn, iX)) + tfWeightX)
        array<int> orderedX = array.sort_indices(keysX, order.descending)
        for iX in orderedX
            label lbX = array.get(lgLbl, iX)
            if not na(lbX)
                int sX = array.get(lgSlot, iX)
                int scX = array.get(slotCountsX, sX) + 1
                array.set(slotCountsX, sX, scX)
                bool overSlotCapX = (sX == 0 and scX > m5CapX) or (sX == 1 and scX > m15CapX)
                visibleX += 1
                if visibleX > visibleHistoryLimit or overSlotCapX
                    label.delete(lbX)
                    line.delete(array.get(lgLn, iX))
                    array.set(lgLbl, iX, na)
                    array.set(lgLn, iX, na)
                    if overSlotCapX
                        visibleX -= 1
    0

f_note_summary(string noteX) =>
    array<string> partsX = str.split(noteX, "\n")
    string tX = array.size(partsX) > 0 ? array.get(partsX, 0) : ""
    tX := str.length(tX) > 48 ? str.substring(tX, 0, 48) + "…" : tX
    for pX in partsX
        if str.contains(pX, "Skor skenario")
            tX += "\n" + pX
            break
    tX

f_lg_draw(int idx) =>
    if idx >= 0
        label oldL = array.get(lgLbl, idx)
        line oldN = array.get(lgLn, idx)
        if not na(oldL)
            label.delete(oldL)
        if not na(oldN)
            line.delete(oldN)
        label newL = na
        line newN = na
        int skipV = array.get(lgSkip, idx)
        int resV = array.get(lgRes, idx)
        int bornT = array.get(lgBorn, idx)
        int endT = array.get(lgEnd, idx)
        int horDrawX = f_slot_hor(array.get(lgSlot, idx))
        int retentionDaysX = horDrawX == 3 ? math.max(resolvedHistoryDays * 4, 60) : horDrawX == 2 ? math.max(resolvedHistoryDays * 2, 30) : resolvedHistoryDays
        bool historyOK = bornT >= dayStartNow - retentionDaysX * 86400000 or (not na(endT) and endT >= dayStartNow - retentionDaysX * 86400000)
        bool wantDraw = showLedger and historyOK and (resV != 0 or skipV == 1) and (skipV == 0 or showSkipped)
        if wantDraw
            int sideV = array.get(lgSide, idx)
            float eV = array.get(lgE, idx)
            float rV = array.get(lgR, idx)
            float cV = array.get(lgCtx, idx)
            string kindT = array.get(lgKind, idx)
            string nameT = f_slot_name(array.get(lgSlot, idx)) + " " + f_setup_name(array.get(lgMethod, idx))
            string sideT = sideV == 1 ? "BUY" : "SELL"
            // WIN follows net realized R, including profitable trailing/structure exits.
            string outT = resV == 1 ? "WIN " + kindT + " " + f_signed_r(rV) : kindT == "SL" ? "LOSS SL " + f_signed_r(rV) : "EXIT " + kindT + " " + f_signed_r(rV)
            string txt = skipV == 1 ? nameT + " " + sideT + " SKIP • " + array.get(lgWhy, idx) + (resV != 0 ? "\nandai masuk: " + outT : "") : nameT + " " + sideT + " " + outT + " • " + f_tier(cV) + " " + f_num(cV)
            string noteV = array.get(lgNote, idx)
            txt += "\n" + (showPatternNotes ? noteV : f_note_summary(noteV))
            string hintV = noteV + "\nE " + f_price(eV) + " | SL " + f_price(array.get(lgSL, idx)) + " | TP " + f_price(array.get(lgTP, idx)) + "\nExit " + kindT + " " + f_signed_r(rV)
            float exitPxDrawX = eV + sideV * (rV * math.max(math.abs(eV - array.get(lgSL, idx)), syminfo.mintick) + costPrice)
            if compactLabels
                txt := nameT + " " + sideT + " • " + outT
            // Compact mode never hides the agreed entry/target/original stop + actual exit fill price.
            txt += "\n" + f_levels(eV, array.get(lgTP, idx), array.get(lgSL, idx)) + " | X " + f_price(exitPxDrawX)
            color col = skipV == 1 ? color.new(color.gray, 45) : resV == 1 ? color.new(color.green, 5) : kindT == "SL" ? color.new(color.red, 10) : color.new(color.blue, 15)
            newL := f_label(bornT, eV, txt, locX = xloc.bar_time, styleX = sideV == 1 ? label.style_label_up : label.style_label_down, colX = col, sizeX = size.tiny, hintX = hintV)
            if not na(endT) and endT > bornT
                newN := line.new(bornT, eV, endT, eV, xloc = xloc.bar_time, color = color.new(col, 30), style = line.style_dotted, width = 1)
        array.set(lgLbl, idx, newL)
        array.set(lgLn, idx, newN)
        f_lg_limit_drawings()

f_lg_ensure(int slotX, int horX, int bornX, int sideX, float eX, float slX, float tpX, float qX, float posX, int endT, int methodX, string noteX, float frozenContextX, string frozenWhyX) =>
    int idx = -1
    bool okData = not na(bornX) and sideX != 0 and not na(eX) and not na(slX) and not na(tpX)
    if okData
        idx := f_lg_find(slotX, bornX)
        if idx < 0
            int retentionEnsureDaysX = horX == 3 ? math.max(resolvedHistoryDays * 4, 60) : horX == 2 ? math.max(resolvedHistoryDays * 2, 30) : resolvedHistoryDays
            bool relevant = na(endT) ? bornX >= dayStartNow - f_mtf_life_ms(horX) : endT >= dayStartNow - retentionEnsureDaysX * 86400000
            if relevant
                float cs = frozenContextX
                string whyV = frozenWhyX
                int skipV = (ctxFilter and whyV != "") or (outputTrendGuard and whyV == "OUTPUT: dua TF atas lawan") ? 1 : 0
                array.push(lgNote, noteX)
                array.push(lgMethod, methodX)
                array.push(lgSlot, slotX)
                array.push(lgBorn, bornX)
                array.push(lgSide, sideX)
                array.push(lgE, eX)
                array.push(lgSL, slX)
                array.push(lgTP, tpX)
                array.push(lgCtx, cs)
                array.push(lgSkip, skipV)
                array.push(lgWhy, whyV)
                array.push(lgRes, 0)
                array.push(lgEnd, int(na))
                array.push(lgR, 0.0)
                array.push(lgKind, "")
                label nl = na
                line nn = na
                array.push(lgLbl, nl)
                array.push(lgLn, nn)
                idx := array.size(lgBorn) - 1
                if skipV == 1
                    f_lg_draw(idx)
    idx

// Permanent Cumulative Statistics UDT (mutating UDT fields inside functions is native to Pine Script v6; never altered when visual labels are purged)
type GGPermStats
    int totalClosed = 0
    int tpHits = 0
    int profExits = 0
    int slHits = 0
    int cutHits = 0
    int beTrailHits = 0
    int staleHits = 0
    float sumWinR = 0.0
    float sumLossR = 0.0
    int winCount = 0
    int lossCount = 0
    float cumR = 0.0
    float peakR = 0.0
    float maxDdR = 0.0
    int curLossStreak = 0
    int maxLossStreak = 0

var GGPermStats permStats = GGPermStats.new()
var array<int> permTfTotal = array.new<int>(7, 0)
var array<int> permTfTp = array.new<int>(7, 0)
var array<int> permTfProf = array.new<int>(7, 0)
var array<float> permTfNetR = array.new<float>(7, 0.0)

f_lg_resolve(int idx, int resX, string kindX, int endT, float pxX) =>
    if idx >= 0
        if array.get(lgRes, idx) == 0
            int sideV = array.get(lgSide, idx)
            float eV = array.get(lgE, idx)
            float slV = array.get(lgSL, idx)
            float tpV = array.get(lgTP, idx)
            float risk = math.max(math.abs(eV - slV), syminfo.mintick)
            float exitPx = not na(pxX) ? pxX : kindX == "TP" ? tpV : kindX == "SL" ? (slV - sideV * slippagePrice) : eV
            float rV = (sideV * (exitPx - eV) - costPrice) / risk
            int netResult = rV > 0.000001 ? 1 : rV < -0.000001 ? -1 : 2
            array.set(lgRes, idx, netResult)
            array.set(lgEnd, idx, endT)
            array.set(lgR, idx, rV)
            array.set(lgKind, idx, kindX)
            // Record into Permanent Statistics UDT if actionable (skip == 0)
            if array.get(lgSkip, idx) == 0
                permStats.totalClosed += 1
                int sSlot = array.get(lgSlot, idx)
                array.set(permTfTotal, sSlot, array.get(permTfTotal, sSlot) + 1)
                array.set(permTfNetR, sSlot, array.get(permTfNetR, sSlot) + rV)
                if kindX == "TP" and netResult == 1
                    permStats.tpHits += 1
                    array.set(permTfTp, sSlot, array.get(permTfTp, sSlot) + 1)
                if netResult == 1
                    permStats.profExits += 1
                    permStats.winCount += 1
                    permStats.sumWinR += rV
                    permStats.curLossStreak := 0
                    array.set(permTfProf, sSlot, array.get(permTfProf, sSlot) + 1)
                else
                    permStats.lossCount += 1
                    permStats.sumLossR += math.abs(rV)
                    permStats.curLossStreak += 1
                    permStats.maxLossStreak := math.max(permStats.maxLossStreak, permStats.curLossStreak)
                if kindX == "SL"
                    permStats.slHits += 1
                else if kindX == "CUT LOSS" or kindX == "STRUCTURE" or kindX == "FAILED BREAK"
                    permStats.cutHits += 1
                else if kindX == "TRAIL/BE"
                    permStats.beTrailHits += 1
                else if kindX == "STALE"
                    permStats.staleHits += 1
                permStats.cumR += rV
                permStats.peakR := math.max(permStats.peakR, permStats.cumR)
                permStats.maxDdR := math.max(permStats.maxDdR, permStats.peakR - permStats.cumR)
            f_lg_draw(idx)

f_lg_purge() =>
    int n = array.size(lgBorn)
    if n > 0
        for i = n - 1 to 0
            int rV = array.get(lgRes, i)
            int endV = array.get(lgEnd, i)
            int bV = array.get(lgBorn, i)
            int horPurgeX = f_slot_hor(array.get(lgSlot, i))
            int retentionPurgeDaysX = horPurgeX == 3 ? math.max(resolvedHistoryDays * 4, 60) : horPurgeX == 2 ? math.max(resolvedHistoryDays * 2, 30) : resolvedHistoryDays
            bool oldV = rV != 0 ? endV < dayStartNow - retentionPurgeDaysX * 86400000 : bV < dayStartNow - 60 * 86400000
            if oldV
                label lOld = array.get(lgLbl, i)
                line nOld = array.get(lgLn, i)
                if not na(lOld)
                    label.delete(lOld)
                if not na(nOld)
                    line.delete(nOld)
                array.remove(lgNote, i)
                array.remove(lgMethod, i)
                array.remove(lgSlot, i)
                array.remove(lgBorn, i)
                array.remove(lgSide, i)
                array.remove(lgE, i)
                array.remove(lgSL, i)
                array.remove(lgTP, i)
                array.remove(lgCtx, i)
                array.remove(lgSkip, i)
                array.remove(lgWhy, i)
                array.remove(lgRes, i)
                array.remove(lgEnd, i)
                array.remove(lgR, i)
                array.remove(lgKind, i)
                array.remove(lgLbl, i)
                array.remove(lgLn, i)


// Reads every native sample (all intrabars when the target TF is below the chart TF) so no birth / resolution is missed.
f_ingest(int slotX, int horX, array<GGNativeState> packetsX, GGNativeState fallbackX) =>
    bool useArrX = false
    if not na(packetsX)
        useArrX := array.size(packetsX) > 0
    int nX = useArrX ? array.size(packetsX) : 1
    for kX = 0 to nX - 1
        GGNativeState packetX = useArrX ? array.get(packetsX, kX) : fallbackX
        if not na(packetX)
            if packetX.liveSide != 0 and not na(packetX.liveBorn)
                f_lg_ensure(slotX, horX, packetX.liveBorn, packetX.liveSide, packetX.liveEntry, packetX.initialSL, packetX.liveTP, packetX.liveQ, packetX.livePos, int(na), packetX.liveMethod, packetX.liveNote, packetX.liveContext, packetX.liveWhy)
            if not na(packetX.resBorn) and packetX.resBorn != nz(array.get(slotLastRes, slotX), 0)
                int idx = f_lg_ensure(slotX, horX, packetX.resBorn, packetX.resSide, packetX.resE, packetX.resSL, packetX.resTP, packetX.resQ, packetX.resPos, packetX.resTime, packetX.resMethod, packetX.resNote, packetX.resContext, packetX.resWhy)
                if idx >= 0
                    string kindX = packetX.resCode == 1 ? "TP" : packetX.resCode == -1 ? "SL" : packetX.resCode == 5 ? "TRAIL/BE" : packetX.resCode == 6 ? "CUT LOSS" : packetX.resCode == 2 ? "STRUCTURE" : packetX.resCode == 4 ? "FAILED BREAK" : "STALE"
                    f_lg_resolve(idx, packetX.resCode, kindX, packetX.resTime, packetX.resPrice)
                array.set(slotLastRes, slotX, packetX.resBorn)

f_lg_is_open(int slotX, int bornX) =>
    int idx = f_lg_find(slotX, bornX)
    idx < 0 ? true : array.get(lgRes, idx) == 0

// Host-side live events (intrabar SL/TP touch, Breakout Defense cut) + read back the confluence verdict of the current signal.
f_track(int slotX, int horX, int liveX, int bornX, float eX, float slX, float tpX, float qX, float posX, int hitX, bool cutX, float hitPriceX) =>
    GGNativeState detailX = f_slot_detail(slotX)
    int methodX = na(detailX) ? 0 : detailX.liveMethod
    int idx = liveX != 0 ? f_lg_ensure(slotX, horX, bornX, liveX, eX, na(detailX) ? slX : detailX.initialSL, tpX, qX, posX, int(na), methodX, na(detailX) ? "" : detailX.liveNote, na(detailX) ? na : detailX.liveContext, na(detailX) ? "" : detailX.liveWhy) : -1
    int nowT = math.min(time_close, timenow)
    if idx >= 0 and array.get(lgRes, idx) == 0 and hitX != 0
        float initSLTrackX = na(detailX) ? slX : detailX.initialSL
        bool movedTrackX = liveX * (slX - initSLTrackX) > syminfo.mintick * 0.5
        int hResCodeX = hitX == -1 or hitX == 2 ? (movedTrackX ? 5 : -1) : 1
        string hKindX = hResCodeX == 1 ? "TP" : hResCodeX == 5 ? "TRAIL/BE" : "SL"
        f_lg_resolve(idx, hResCodeX, hKindX, nowT, hitPriceX)
    int skipOut = idx >= 0 ? array.get(lgSkip, idx) : 0
    float ctxOut = idx >= 0 ? array.get(lgCtx, idx) : na
    string whyOut = idx >= 0 ? array.get(lgWhy, idx) : ""
    [skipOut, ctxOut, whyOut]

f_lg_purge()
for slotX = 0 to 6
    GGNativeFeed feedX = array.get(nativeFeeds, slotX)
    f_ingest(slotX, f_slot_hor(slotX), feedX.packetArr, feedX.packetSec)
array<int> hostSkips = array.new<int>()
array<float> hostContexts = array.new<float>()
array<int> hostViews = array.new<int>()
for slotX = 0 to 6
    GGNativeState detailX = f_slot_detail(slotX)
    [srcX, biasX, sigX, watchQX, liveX, bornX, entryX, slX, tpX, qX, posX] = f_native_fields(detailX)
    int hitX = array.get(hostHits, slotX)
    bool cutX = array.get(hostCuts, slotX)
    [skipX, ctxX, whyX] = f_track(slotX, f_slot_hor(slotX), liveX, bornX, entryX, slX, tpX, qX, posX, hitX, cutX, array.get(hostHitPrices, slotX))
    array.push(hostSkips, skipX)
    array.push(hostContexts, ctxX)
for slotX = 0 to 6
    GGNativeState detailX = f_slot_detail(slotX)
    int bornX = na(detailX) ? int(na) : detailX.liveBorn
    int liveX = na(detailX) ? int(na) : detailX.liveSide
    array.push(hostViews, array.get(hostHits, slotX) == 0 and not array.get(hostCuts, slotX) and array.get(hostSkips, slotX) == 0 and f_lg_is_open(slotX, bornX) ? liveX : 0)
float m5Ctx = array.get(hostContexts, 0)
float m15Ctx = array.get(hostContexts, 1)
int m5LiveView = array.get(hostViews, 0)
int m15LiveView = array.get(hostViews, 1)

// ===== SCALP CONFLICT RESOLVER =====
// M15 is the anchor/context and M5 is the execution trigger, but GoldGuard does
// not publish two opposite actionable scalp signals at the same time. If both
// are ACTIVE and disagree, the only actionable decision is WAIT CONFLICT.
// The raw M5/M15 rows remain visible as CONTEXT so the user can understand why.
bool scalpConflict = scalpConflictGuard and m5LiveView != 0 and m15LiveView != 0 and m5LiveView != m15LiveView
bool scalpAligned = m5LiveView != 0 and m15LiveView != 0 and m5LiveView == m15LiveView
int scalpMasterSide = scalpConflict ? 0 : m5LiveView != 0 ? m5LiveView : m15LiveView
string scalpMasterSource = scalpConflict ? "M5 vs M15" : scalpAligned ? "M5+M15" : m5LiveView != 0 ? "M5" : m15LiveView != 0 ? "M15" : "-"
int scalpMasterBorn = scalpMasterSide == 0 ? na : m5LiveView != 0 ? m5Born : m15Born
float scalpMasterE = scalpMasterSide == 0 ? na : m5LiveView != 0 ? m5E : m15E
float scalpMasterSL = scalpMasterSide == 0 ? na : m5LiveView != 0 ? m5SL : m15SL
float scalpMasterTP = scalpMasterSide == 0 ? na : m5LiveView != 0 ? m5TP : m15TP
float scalpMasterQ = scalpMasterSide == 0 ? na : scalpAligned ? math.max(nz(m5Ctx, 0.0), nz(m15Ctx, 0.0)) : m5LiveView != 0 ? m5Ctx : m15Ctx

// ACTIVE labels are a direct projection of the exact canonical table state.
// No second lifecycle exists on the host chart anymore.
var array<box> classicTPBoxes = array.new<box>(7, na)
var array<box> classicSLBoxes = array.new<box>(7, na)
var array<line> classicEntryLines = array.new<line>(7, na)
var array<label> classicTPLabels = array.new<label>(7, na)
var array<label> classicSLLabels = array.new<label>(7, na)
f_sync_active_area(int slotX, string tfX, int horizonX, int sideX, int bornX, float eX, float slX, float tpX, string tagX) =>
    box.delete(array.get(classicTPBoxes, slotX))
    box.delete(array.get(classicSLBoxes, slotX))
    line.delete(array.get(classicEntryLines, slotX))
    label.delete(array.get(classicTPLabels, slotX))
    label.delete(array.get(classicSLLabels, slotX))
    array.set(classicTPBoxes, slotX, na)
    array.set(classicSLBoxes, slotX, na)
    array.set(classicEntryLines, slotX, na)
    array.set(classicTPLabels, slotX, na)
    array.set(classicSLLabels, slotX, na)
    bool scopeX = activeAreaScope == "Semua" or (activeAreaScope == "Scalp" and horizonX == 1) or (activeAreaScope == "Intraday" and horizonX == 2) or (activeAreaScope == "Swing" and horizonX == 3)
    bool drawX = showActiveAreas and scopeX and tagX == "ACTIVE" and sideX != 0 and not na(bornX) and not na(eX) and not na(slX) and not na(tpX)
    if drawX
        int chartMsX = int(timeframe.in_seconds() * 1000)
        int leftX = math.max(bornX, time - chartMsX * 160)
        int rightX = time_close + chartMsX * (activeAreaBars + slotX * 3)
        string sideTxt = "ACTIVE " + tfX + (sideX == 1 ? " BUY" : " SELL")
        box tpBoxX = box.new(leftX, math.max(eX, tpX), rightX, math.min(eX, tpX), xloc = xloc.bar_time, bgcolor = color.new(color.green, 87), border_color = color.new(color.lime, 30))
        box slBoxX = box.new(leftX, math.max(eX, slX), rightX, math.min(eX, slX), xloc = xloc.bar_time, bgcolor = color.new(color.red, 89), border_color = color.new(color.red, 30))
        line entryLineX = line.new(leftX, eX, rightX, eX, xloc = xloc.bar_time, color = color.orange, style = line.style_dashed, width = 1)
        label tpLabelX = f_label(rightX, tpX, sideTxt + " TP " + f_price(tpX), locX = xloc.bar_time, styleX = label.style_label_left, colX = color.new(color.orange, 8), sizeX = size.small)
        label slLabelX = f_label(rightX, slX, sideTxt + " SL " + f_price(slX), locX = xloc.bar_time, styleX = label.style_label_left, colX = color.new(color.orange, 8), sizeX = size.small)
        label.set_textcolor(tpLabelX, color.black)
        label.set_textcolor(slLabelX, color.black)
        array.set(classicTPBoxes, slotX, tpBoxX)
        array.set(classicSLBoxes, slotX, slBoxX)
        array.set(classicEntryLines, slotX, entryLineX)
        array.set(classicTPLabels, slotX, tpLabelX)
        array.set(classicSLLabels, slotX, slLabelX)

var array<label> mtfLiveLabels = array.new<label>(7, na)
var array<int> mtfLiveLabelSides = array.new<int>(7, 0)
f_sync_mtf_label(int slot, string tfX, int horizonX, int liveSideX, int bornX, float eX, float slX, float tpX, float qX, string tagX) =>
    f_sync_active_area(slot, tfX, horizonX, liveSideX, bornX, eX, slX, tpX, tagX)
    label lb = array.get(mtfLiveLabels, slot)
    int oldSide = array.get(mtfLiveLabelSides, slot)
    bool visible = showMTFMap and showMTFLabels and liveSideX != 0 and not na(bornX) and not na(eX) and not na(slX) and not na(tpX)
    if visible
        float slP = math.abs(eX - slX) / goldPipSize
        float tpP = math.abs(tpX - eX) / goldPipSize
        GGNativeState detailX = f_slot_detail(slot == 0 and tfX == "M15" ? 1 : slot)
        string methodTextX = na(detailX) ? "" : f_setup_name(detailX.liveMethod)
        string txt = tagX + " " + methodTextX + " " + tfX + " " + f_horizon_name(horizonX) + " " + (liveSideX == 1 ? "BUY" : "SELL") + " • " + f_tier(qX) + " " + f_num(qX) + "\nE " + f_price(eX) + " | SL " + f_price(slX) + " (" + f_num(slP) + "p)\nTP " + f_price(tpX) + " (" + f_num(tpP) + "p)"
        string liveHintX = ""
        if not na(detailX)
            int noteIdxX = f_lg_find(slot == 0 and tfX == "M15" ? 1 : slot, bornX)
            liveHintX := noteIdxX >= 0 ? array.get(lgNote, noteIdxX) : detailX.liveNote
            txt += "\n" + (showPatternNotes ? liveHintX : f_note_summary(liveHintX))
        if compactLabels
            txt := tagX + " " + tfX + " " + (liveSideX == 1 ? "BUY" : "SELL") + " • " + methodTextX + " " + f_num(qX) + "\n" + f_levels(eX, tpX, slX)
        liveHintX += "\n" + f_levels(eX, tpX, slX)
        if not na(detailX) and math.abs(detailX.initialSL - slX) >= syminfo.mintick
            txt += "\nSL awal " + f_price(detailX.initialSL) + " | SL kini dikelola"
            liveHintX += "\nSL awal " + f_price(detailX.initialSL)
        color colX = tagX == "ACTIVE" ? color.new(color.orange, 8) : color.new(color.gray, 25)
        if na(lb) or oldSide != liveSideX
            if not na(lb)
                label.delete(lb)
            lb := f_label(bornX, eX, txt, locX = xloc.bar_time, styleX = liveSideX == 1 ? label.style_label_up : label.style_label_down, colX = colX, sizeX = size.tiny, hintX = liveHintX)
            array.set(mtfLiveLabels, slot, lb)
            array.set(mtfLiveLabelSides, slot, liveSideX)
        else
            label.set_x(lb, bornX)
            label.set_y(lb, eX)
            label.set_text(lb, txt)
            label.set_tooltip(lb, liveHintX)
            label.set_color(lb, colX)
            label.set_size(lb, size.tiny)
        label.set_textcolor(lb, tagX == "ACTIVE" ? color.black : color.white)
    else if not na(lb)
        label.delete(lb)
        array.set(mtfLiveLabels, slot, na)
        array.set(mtfLiveLabelSides, slot, 0)

if barstate.islast
    f_lg_limit_drawings()

if barstate.islast
    for slotX = 0 to 6
        GGNativeState detailX = f_slot_detail(slotX)
        [srcX, biasX, sigX, watchQX, liveX, bornX, entryX, slX, tpX, qX, posX] = f_native_fields(detailX)
        string tagX = scalpConflict and slotX < 2 ? "CONTEXT" : "ACTIVE"
        f_sync_mtf_label(slotX, f_slot_name(slotX), f_slot_hor(slotX), array.get(hostViews, slotX), bornX, entryX, slX, tpX, array.get(hostContexts, slotX), tagX)

// ===== POSSIBLE MAP: chart-TF scenario, separate from canonical MTF trades =====
// No scenario score creates a trade, changes a result, or fires an alert. Scores
// Scenario scores are heuristic and are not calibrated probabilities.


f_map_plan(int sideX, float levelX, float anchorX, float targetWallX, float atrX, int horizonX) =>
    float entryX = na(levelX) ? na : f_round(levelX)
    float halfX = math.max(syminfo.mintick, possibleWidthATR * atrX)
    float atrStopX = horizonX == 1 ? scalpStopATR + (timeframe.in_seconds() <= 300 ? scalpM5ExtraATR : 0.0) : horizonX == 2 ? intradayStopATR : swingStopATR
    float minStopX = isGold ? (horizonX == 1 ? scalpMinPips : horizonX == 2 ? intradayMinPips : swingMinPips) * goldPipSize : atrStopX * atrX
    // SL is beyond BOTH the complete entry band and all adjacent structures.
    float structuralX = sideX == 1 ? math.min(anchorX, entryX - halfX) : math.max(anchorX, entryX + halfX)
    float riskX = math.max(minStopX, math.max(atrStopX * atrX, sideX * (entryX - structuralX) + (horizonX == 1 ? math.max(srBufferATR, scalpSLBufferATR) : srBufferATR) * atrX))
    float rawStopX = entryX - sideX * riskX
    float slX = (sideX == 1 ? math.floor(rawStopX / syminfo.mintick) : math.ceil(rawStopX / syminfo.mintick)) * syminfo.mintick
    riskX := sideX * (entryX - slX)
    // A target must have an observed opposing level. Never invent a distant TP.
    float roomX = sideX * (targetWallX - entryX) - 0.20 * atrX
    float rrX = horizonX == 1 ? 1.65 : horizonX == 2 ? 1.65 : 1.85
    float rewardX = math.min(rrX * riskX, roomX)
    float tpX = f_round(entryX + sideX * rewardX)
    // Conservative RR uses the worst fill inside the proposed entry zone.
    float worstEntryX = entryX + sideX * halfX
    float netX = (sideX * (tpX - worstEntryX) - costPrice) / math.max(sideX * (worstEntryX - slX) + costPrice, syminfo.mintick)
    bool validX = not na(entryX) and not na(targetWallX) and not na(anchorX) and not na(atrX) and atrX > 0 and riskX > 0 and riskX <= classicMaxRiskATR * atrX and roomX >= srMinRoomATR * atrX and netX >= classicMinNetRR and costPrice <= riskX * 0.20 and sideX * (tpX - worstEntryX) > 0
    [validX, entryX, slX, tpX, netX]

// Display projection of the SAME native zones used by breakout and retest.
// xloc.bar_time preserves M5...W1 boxes when switching chart timeframe.
type GGMapZone
    int born
    int side
    float lo
    float hi
    float quality
    string name
    string status
    int tests
    int pending
    string origin
    bool strong
    string tf

var array<box> strongZoneBoxes = array.new<box>(64, na)
array<GGMapZone> mapZones = array.new<GGMapZone>()
float mapC = close[1]
float mapATR = atr[1]
float possibleSupport = na
float possibleResistance = na
float possibleBuyAnchor = na
float possibleSellAnchor = na
float possibleBuyWall = na
float possibleSellWall = na
string possibleSupportKind = "SUPPORT"
string possibleResistanceKind = "RESISTANCE"
// The chart-only pool also records past S/R strength; native trade pools do not.
var array<GGZoneHistory> chartZoneHistoryX = array.new<GGZoneHistory>()
[chartBrSideX, chartBrLoX, chartBrHiX, _, _, _, _, _, _, _, _, _, chartBrGradeX, chartZoneMapX] = f_zone_snapshot(chartZoneHistoryX)
bool chartHasNativeZoneX = false
for nativeZonePeriodX in nativePeriods
    if timeframe.in_seconds(nativeZonePeriodX) == timeframe.in_seconds()
        chartHasNativeZoneX := true
// Exactly one map source: native packet for a supported TF, chart pool otherwise.
string customZoneMapX = chartHasNativeZoneX ? "" : chartZoneMapX
if barstate.islast
    for slotX = 0 to 7
        GGNativeState packetX = slotX < 7 ? f_slot_detail(slotX) : na
        bool matchingX = slotX == 7 ? customZoneMapX != "" : timeframe.in_seconds(array.get(nativePeriods, slotX)) == timeframe.in_seconds()
        string zoneTextX = slotX == 7 ? customZoneMapX : na(packetX) ? "" : packetX.zoneMap
        if matchingX and zoneTextX != ""
            array<string> rowsX = str.split(zoneTextX, ";")
            for rowX in rowsX
                array<string> pX = str.split(rowX, ",")
                if array.size(pX) == 11
                    GGMapZone zX = GGMapZone.new(int(str.tonumber(array.get(pX, 0))), int(str.tonumber(array.get(pX, 1))), str.tonumber(array.get(pX, 2)), str.tonumber(array.get(pX, 3)), str.tonumber(array.get(pX, 4)), array.get(pX, 5), array.get(pX, 6), int(str.tonumber(array.get(pX, 7))), int(str.tonumber(array.get(pX, 8))), array.get(pX, 9), array.get(pX, 10) == "1", slotX == 7 ? timeframe.period : f_slot_name(slotX))
                    array.push(mapZones, zX)
                    bool usableX = zX.strong and zX.pending == 0 and not str.contains(zX.status, "UJI TEMBUS") and math.abs((zX.lo + zX.hi) / 2 - mapC) <= possibleReachATR * mapATR
                    if usableX and zX.side == 1 and zX.hi < mapC and (na(possibleSupport) or zX.hi > possibleSupport)
                        possibleSupport := zX.hi
                        possibleBuyAnchor := zX.lo
                        possibleSellWall := zX.hi
                        possibleSupportKind := zX.name + " " + zX.tf
                    if usableX and zX.side == -1 and zX.lo > mapC and (na(possibleResistance) or zX.lo < possibleResistance)
                        possibleResistance := zX.lo
                        possibleSellAnchor := zX.hi
                        possibleBuyWall := zX.lo
                        possibleResistanceKind := zX.name + " " + zX.tf
    for zX in mapZones
        if zX.strong and zX.pending == 0 and not str.contains(zX.status, "UJI TEMBUS")
            if zX.side == 1 and not na(possibleSupport) and zX.lo <= possibleSupport and possibleSupport - zX.lo <= srClusterATR * mapATR
                possibleBuyAnchor := math.min(possibleBuyAnchor, zX.lo)
            if zX.side == -1 and not na(possibleResistance) and zX.hi >= possibleResistance and zX.hi - possibleResistance <= srClusterATR * mapATR
                possibleSellAnchor := math.max(possibleSellAnchor, zX.hi)
    array<int> pickedX = array.new<int>()
    for slotX = 0 to 63
        int bestX = -1
        float bestRankX = -1e10
        if showZones and slotX < strongZoneLimit and not na(mapATR) and mapATR > 0 and array.size(mapZones) > 0
            for iX = 0 to array.size(mapZones) - 1
                GGMapZone zX = array.get(mapZones, iX)
                float distanceX = math.abs((zX.lo + zX.hi) / 2 - mapC) / mapATR
                float rankX = zX.quality - 3.0 * distanceX
                if (not strongOnlyZones or zX.strong) and not array.includes(pickedX, iX) and rankX > bestRankX
                    bestX := iX
                    bestRankX := rankX
        box bxX = array.get(strongZoneBoxes, slotX)
        if bestX < 0
            box.delete(bxX)
            array.set(strongZoneBoxes, slotX, na)
        else
            array.push(pickedX, bestX)
            GGMapZone zX = array.get(mapZones, bestX)
            bool sdX = zX.name == "SUPPLY" or zX.name == "DEMAND"
            bool pendingX = zX.pending > 0 or str.contains(zX.status, "UJI TEMBUS")
            color colX = pendingX ? color.orange : sdX ? (zX.side == 1 ? color.blue : color.purple) : zX.side == 1 ? color.teal : color.red
            string txtX = zX.name + " | " + zX.tf + " | " + zX.status + (sdX ? "" : " | tes " + str.tostring(zX.tests)) + (zX.origin == "-" ? "" : " | " + zX.origin)
            int rightX = time_close + int(timeframe.in_seconds() * 1000) * possibleBars
            if na(bxX)
                bxX := box.new(zX.born, zX.hi, rightX, zX.lo, xloc = xloc.bar_time, border_color = colX, bgcolor = color.new(colX, 93), text = txtX, text_color = colX, text_size = size.tiny)
                array.set(strongZoneBoxes, slotX, bxX)
            else
                box.set_lefttop(bxX, zX.born, zX.hi)
                box.set_rightbottom(bxX, rightX, zX.lo)
                box.set_border_color(bxX, colX)
                box.set_bgcolor(bxX, color.new(colX, 93))
                box.set_text(bxX, txtX)
                box.set_text_color(bxX, colX)
            box.set_border_style(bxX, sdX ? line.style_dotted : pendingX or str.contains(zX.status, "LEMAH") ? line.style_dashed : line.style_solid)


// Freeze historical rectangles at their endpoint instead of projecting them
// to the right like active zones. Only the most recent closed intervals appear.
var array<box> zoneHistoryBoxesX = array.new<box>(12, na)
if barstate.islast
    array<int> historyPickedX = array.new<int>()
    for slotX = 0 to 11
        int bestX = -1
        if showZones and showZoneHistory and slotX < zoneHistoryLimit and array.size(chartZoneHistoryX) > 0
            for iX = array.size(chartZoneHistoryX) - 1 to 0
                GGZoneHistory rX = array.get(chartZoneHistoryX, iX)
                if not rX.active and rX.last > rX.first and not array.includes(historyPickedX, iX)
                    bestX := iX
                    break
        box bxX = array.get(zoneHistoryBoxesX, slotX)
        if bestX < 0
            box.delete(bxX)
            array.set(zoneHistoryBoxesX, slotX, na)
        else
            array.push(historyPickedX, bestX)
            GGZoneHistory rX = array.get(chartZoneHistoryX, bestX)
            color colX = rX.side == 1 ? color.teal : color.red
            string tfX = timeframe.isintraday ? "TF " + timeframe.period : timeframe.period
            string txtX = rX.name + " | " + tfX + " | RIWAYAT"
            if na(bxX)
                bxX := box.new(rX.first, rX.hi, rX.last, rX.lo, xloc = xloc.bar_time, border_color = color.new(colX, 25), bgcolor = color.new(colX, 95), text = txtX, text_color = color.new(colX, 15), text_size = size.tiny, border_style = line.style_dashed)
                array.set(zoneHistoryBoxesX, slotX, bxX)
            else
                box.set_lefttop(bxX, rX.first, rX.hi)
                box.set_rightbottom(bxX, rX.last, rX.lo)
                box.set_border_color(bxX, color.new(colX, 25))
                box.set_bgcolor(bxX, color.new(colX, 95))
                box.set_text_color(bxX, color.new(colX, 15))
                box.set_text(bxX, txtX)


float chartSecMap = timeframe.in_seconds()
// Exact supported TF; otherwise explicitly show the closest lower native base.
int mapSlot = chartSecMap < 900 ? 0 : chartSecMap < 1800 ? 1 : chartSecMap < 3600 ? 6 : chartSecMap < 14400 ? 2 : chartSecMap < 86400 ? 3 : chartSecMap < 604800 ? 4 : 5
int mapHorizon = f_slot_hor(mapSlot)
GGNativeState mapDetail = f_slot_detail(mapSlot)
int mapTrend = na(mapDetail) ? 0 : mapDetail.bias
int mapParent = chartSecMap < 900 ? nz(m15Bias, 0) : chartSecMap < 3600 ? nz(h1BiasMap, 0) : chartSecMap < 14400 ? nz(h4BiasMap, 0) : chartSecMap < 86400 ? nz(d1BiasMap, 0) : chartSecMap < 604800 ? nz(w1BiasMap, 0) : 0
[mapMacro, mapMacroCount] = f_macro_at(mapHorizon, time_close[1])
float possibleUpPct = f_forward_score(mapSlot)
float possibleDownPct = na(possibleUpPct) ? na : 100.0 - possibleUpPct
bool mapDataOK = not na(possibleUpPct) and not na(mapATR) and mapATR > 0
bool mapChop = not na(possibleUpPct) and math.abs(possibleUpPct - 50) < 8


[mapBuyValid, mapBuyE, mapBuySL, mapBuyTP, mapBuyRR] = f_map_plan(1, possibleSupport, possibleBuyAnchor, possibleBuyWall, mapATR, mapHorizon)
[mapSellValid, mapSellE, mapSellSL, mapSellTP, mapSellRR] = f_map_plan(-1, possibleResistance, possibleSellAnchor, possibleSellWall, mapATR, mapHorizon)
bool mapNewsBlocked = newsWindow and mapHorizon <= 2
bool mapSessionBlocked = useSession and na(time(timeframe.period, sessionHours, tz))
bool mapRollover = sessionFilter and mapHorizon == 1 and (hour(time_close, "America/New_York") == 17 or (hour(time_close, "America/New_York") == 16 and minute(time_close, "America/New_York") >= 45))
bool mapBuyEligible = mapBuyValid and mapDataOK and mapTrend == 1 and (not htfVeto or mapParent != -1) and (not macroVeto or mapHorizon == 1 or mapMacro > -0.99) and not mapNewsBlocked and not mapSessionBlocked and not mapRollover and time_close[1] >= startTest
bool mapSellEligible = mapSellValid and mapDataOK and mapTrend == -1 and (not htfVeto or mapParent != 1) and (not macroVeto or mapHorizon == 1 or mapMacro < 0.99) and not mapNewsBlocked and not mapSessionBlocked and not mapRollover and time_close[1] >= startTest

// Gap drawing belongs to the host chart only. No cross-TF gap transport.
type GGGap
    int side
    float lo
    float hi
    int born
    int bornBar
    string kind
    bool partial = false

f_add_gap(array<GGGap> gaps, int side, float lo, float hi, int born, int bornBar, string kind) =>
    bool duplicate = false
    for g in gaps
        if g.side == side and g.kind == kind and lo <= g.hi and hi >= g.lo
            duplicate := true
            break
    if not duplicate and not na(lo) and not na(hi) and hi - lo >= syminfo.mintick
        array.push(gaps, GGGap.new(side, lo, hi, born, bornBar, kind))
        if array.size(gaps) > gapLimit
            array.shift(gaps)
    0

f_update_gaps(array<GGGap> gaps, int nowBar, float h, float l) =>
    if array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            GGGap g = array.get(gaps, i)
            bool later = nowBar > g.bornBar
            bool full = later and (g.side == 1 ? l <= g.lo : h >= g.hi)
            bool expired = nowBar - g.bornBar > gapLifeBars
            if full or expired
                array.remove(gaps, i)
            else if later
                if g.side == 1 and l < g.hi and l > g.lo
                    g.hi := l
                    g.partial := true
                if g.side == -1 and h > g.lo and h < g.hi
                    g.lo := h
                    g.partial := true
    0

f_gap_candidates(float o, float h, float l, float priorClose, float a) =>
    int openSide = not na(a) and math.abs(o - priorClose) >= gapMinATR * a ? (o > priorClose ? 1 : -1) : 0
    float openLo = openSide == 1 ? priorClose : openSide == -1 ? math.max(o, h) : na
    float openHi = openSide == 1 ? math.min(o, l) : openSide == -1 ? priorClose : na
    [openSide, openLo, openHi]

var array<GGGap> chartGaps = array.new<GGGap>()
var array<box> gapBoxes = array.new<box>(20, na)
int closedGapBarX = bar_index - 1
f_update_gaps(chartGaps, closedGapBarX, high[1], low[1])
[openGapSideX, openGapLoX, openGapHiX] = f_gap_candidates(open[1], high[1], low[1], close[2], atr[1])
if showOpenGaps and openGapSideX != 0 and openGapHiX > openGapLoX
    f_add_gap(chartGaps, openGapSideX, openGapLoX, openGapHiX, time_close[1], closedGapBarX, "GAP OPEN")
if barstate.islast
    for slotX = 0 to 19
        box bxX = array.get(gapBoxes, slotX)
        if slotX >= array.size(chartGaps)
            box.delete(bxX)
            array.set(gapBoxes, slotX, na)
        else
            GGGap gX = array.get(chartGaps, array.size(chartGaps) - 1 - slotX)
            color gapColX = color.yellow
            string captionX = gX.kind + (gX.side == 1 ? " UP" : " DOWN") + " | TF " + timeframe.period + (gX.partial ? " | PARTIAL" : " | OPEN")
            int gapRightX = time_close + int(timeframe.in_seconds() * 1000) * possibleBars
            if na(bxX)
                bxX := box.new(gX.born, gX.hi, gapRightX, gX.lo, xloc = xloc.bar_time, border_color = color.new(gapColX, 35), bgcolor = color.new(gapColX, 94), text = captionX, text_color = gapColX, text_size = size.tiny, border_style = line.style_dotted)
                array.set(gapBoxes, slotX, bxX)
            else
                box.set_lefttop(bxX, gX.born, gX.hi)
                box.set_rightbottom(bxX, gapRightX, gX.lo)
                box.set_text(bxX, captionX)
                box.set_border_color(bxX, color.new(gapColX, 35))
                box.set_text_color(bxX, gapColX)
                box.set_bgcolor(bxX, color.new(gapColX, 94))


// Fixed pools: 3 labels, 2 boxes, 6 lines. Update latest drawings in place.
// They cannot evict historical signal labels or exceed future bar limits.
var array<label> possibleLabels = array.new<label>(3, na)
var array<box> possibleBoxes = array.new<box>(2, na)
var array<line> possibleLines = array.new<line>(7, na)
f_map_label(int slotX, int xX, float yX, string textX, color colX, string hintX) =>
    label lbX = array.get(possibleLabels, slotX)
    if na(lbX)
        lbX := f_label(xX, yX, textX, locX = xloc.bar_index, styleX = label.style_label_left, colX = colX, sizeX = size.tiny, alignX = text.align_left, hintX = hintX)
        array.set(possibleLabels, slotX, lbX)
    else
        label.set_xy(lbX, xX, yX)
        label.set_text(lbX, textX)
        label.set_color(lbX, colX)
        label.set_tooltip(lbX, hintX)
    0
f_map_line(int slotX, int x1X, float y1X, int x2X, float y2X, color colX) =>
    line lnX = array.get(possibleLines, slotX)
    if na(lnX)
        lnX := line.new(x1X, y1X, x2X, y2X, xloc = xloc.bar_index, color = colX, style = line.style_dashed, width = 1)
        array.set(possibleLines, slotX, lnX)
    else
        line.set_xy1(lnX, x1X, y1X)
        line.set_xy2(lnX, x2X, y2X)
        line.set_color(lnX, colX)
    0
f_map_clear_side(int slotX) =>
    label.delete(array.get(possibleLabels, slotX + 1))
    box.delete(array.get(possibleBoxes, slotX))
    array.set(possibleLabels, slotX + 1, na)
    array.set(possibleBoxes, slotX, na)
    for kX = slotX * 3 to slotX * 3 + 2
        line.delete(array.get(possibleLines, kX))
        array.set(possibleLines, kX, na)
    0
f_map_draw_side(int slotX, int sideX, float levelX, float slX, float tpX, float netX, bool validX, bool eligibleX, string levelKindX) =>
    int x1X = bar_index + 2
    int x2X = bar_index + possibleBars
    float halfX = math.max(syminfo.mintick, possibleWidthATR * mapATR)
    color sideColX = sideX == 1 ? color.rgb(0, 167, 128) : color.rgb(218, 71, 88)
    color colX = eligibleX ? sideColX : color.rgb(95, 106, 126)
    box bxX = array.get(possibleBoxes, slotX)
    if na(bxX)
        bxX := box.new(x1X, levelX + halfX, x2X, levelX - halfX, border_color = colX, bgcolor = color.new(sideColX, 82))
        array.set(possibleBoxes, slotX, bxX)
    else
        box.set_lefttop(bxX, x1X, levelX + halfX)
        box.set_rightbottom(bxX, x2X, levelX - halfX)
        box.set_border_color(bxX, colX)
        box.set_bgcolor(bxX, color.new(sideColX, 82))
    string sideTextX = sideX == 1 ? "BUY" : "SELL"
    string stageX = mapNewsBlocked ? "BLOK NEWS" : mapSessionBlocked or mapRollover ? "BLOK SESI" : not validX ? "RR KURANG" : not eligibleX ? "TUNGGU TREN" : "TUNGGU REJECTION"
    string txtX = "POSSIBLE " + sideTextX + " • " + levelKindX + "\n" + f_price(f_round(levelX - halfX)) + "–" + f_price(f_round(levelX + halfX)) + "\n" + stageX
    if validX
        txtX += "\nE ~" + f_price(levelX) + " | SL " + f_price(slX) + "\nTP " + f_price(tpX) + " | net " + f_num(netX) + "R"
    float labelY = sideX == 1 ? math.min(levelX, mapC - 0.90 * mapATR) : math.max(levelX, mapC + 0.90 * mapATR)
    f_map_label(slotX + 1, x2X, labelY, txtX, color.new(colX, 8), "Skenario; RR net.")
    int lineBaseX = slotX * 3
    if showPossiblePaths
        f_map_line(lineBaseX, bar_index, mapC, x1X, levelX, color.new(colX, 25))
        if validX and eligibleX
            f_map_line(lineBaseX + 1, x1X, levelX, x2X, tpX, color.new(sideColX, 15))
            f_map_line(lineBaseX + 2, x1X, slX, x2X, slX, color.new(color.red, 40))
        else
            for kX = lineBaseX + 1 to lineBaseX + 2
                line.delete(array.get(possibleLines, kX))
                array.set(possibleLines, kX, na)
    else
        for kX = lineBaseX to lineBaseX + 2
            line.delete(array.get(possibleLines, kX))
            array.set(possibleLines, kX, na)
    0
if barstate.islast
    if showPossibleMap and mapDataOK
        string macroTextX = not useMacro ? "PROXY OFF" : mapMacroCount == 0 ? "PROXY KOSONG" : "PROXY " + (mapMacro > 0 ? "BULLISH" : mapMacro < 0 ? "BEARISH" : "CAMPURAN")
        string manualTextX = f_manual_at(time_close[1]) == 0 ? "manual netral" : "manual " + fundamentalView
        string biasTextX = "BIAS TEKNIKAL " + f_slot_name(mapSlot) + " • " + str.tostring(forecastBars) + " BAR KE DEPAN" + "\nNAIK " + str.tostring(possibleUpPct, "#") + " | TURUN " + str.tostring(possibleDownPct, "#") + (mapChop ? "\nBELUM DOMINAN" : "") + "\n" + macroTextX + " | " + manualTextX + "\nSkor bersyarat • news manual"
        if showTFBias
            biasTextX += "\nTF CANDLE TUTUP" + f_tf_bias_summary()
        f_map_label(0, bar_index + possibleBars, mapC, biasTextX, color.new(color.rgb(31, 45, 68), 5), "Skor bersyarat. Makro proxy; news manual." + (fundamentalNote != "" and f_manual_at(time_close[1]) != 0 ? "\nBerita manual: " + fundamentalNote : ""))
        if not na(possibleSupport) and (possibleBothSides or possibleUpPct >= 50)
            f_map_draw_side(0, 1, mapBuyE, mapBuySL, mapBuyTP, mapBuyRR, mapBuyValid, mapBuyEligible, possibleSupportKind)
        else
            f_map_clear_side(0)
        if not na(possibleResistance) and (possibleBothSides or possibleDownPct > 50)
            f_map_draw_side(1, -1, mapSellE, mapSellSL, mapSellTP, mapSellRR, mapSellValid, mapSellEligible, possibleResistanceKind)
        else
            f_map_clear_side(1)
    else
        label.delete(array.get(possibleLabels, 0))
        array.set(possibleLabels, 0, na)
        f_map_clear_side(0)
        f_map_clear_side(1)


// v1.23.19: removed internal-only legacy SIM ledger (never rendered; canonical MTF engine unchanged).

plot(showEMA ? ema20 : na, "EMA20", color = color.yellow)
plot(showEMA ? ema50 : na, "EMA50", color = color.aqua)
plot(showEMA ? ema200 : na, "EMA200", color = color.orange, linewidth = 2)
plot(not strongOnlyZones ? support : na, "Support", color = color.new(color.teal, 25), style = plot.style_stepline)
plot(not strongOnlyZones ? resistance : na, "Resistance", color = color.new(color.red, 25), style = plot.style_stepline)
// v1.22.5: legacy SIM/audit Data Window plots removed.
// They depended on the host chart timeframe and are not part of canonical MTF signaling.
plotshape(showStructure and sweepUp, "Sweep naik", shape.triangleup, location.belowbar, color.aqua, size = size.tiny, text = "SW")
plotshape(showStructure and sweepDown, "Sweep turun", shape.triangledown, location.abovebar, color.orange, size = size.tiny, text = "SW")
var GGMarkerGate chartMarkerGateX = GGMarkerGate.new()
int chartBreakMarkerX = f_break_marker(chartMarkerGateX, showBreakEvents, chartBrSideX, chartBrGradeX, chartBrLoX, chartBrHiX, atr[1], bar_index - 1)
plotshape(chartBreakMarkerX == 1, "BREAK naik", shape.triangleup, location.belowbar, color.lime, size = size.tiny, text = "BREAK")
plotshape(chartBreakMarkerX == -1, "BREAK turun", shape.triangledown, location.abovebar, color.fuchsia, size = size.tiny, text = "BREAK")
