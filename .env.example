# Vercel Marketplace → Neon → Connect project (optional workspace sync).
DATABASE_URL=

# Licensed Twelve Data history and access to Forex / Metals.
TWELVE_DATA_API_KEY=
TWELVE_DATA_DXY_SYMBOL=DXY
TWELVE_DATA_DELAY_SECONDS=0
# HTTPS URL of the managed Node relay, including /api/stream.
TWELVE_STREAM_URL=
# Relay container only, e.g. https://azusatrade.vercel.app.
TERMINAL_ORIGIN=

# Licensed calendar and market news. Public feeds work without this key.
TRADING_ECONOMICS_API_KEY=

# Optional private, isolated Judge0 service for full C and Java.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_C_LANGUAGE_ID=
JUDGE0_JAVA_LANGUAGE_ID=
# Generate a random operator key. Enter it in Code Editor to authorize remote runs.
RUNNER_ACCESS_KEY=

# Optional. Set to 1 only if the original Pine source can be downloaded publicly.
GOLDGUARD_SOURCE_PUBLIC=0
